	config PACKAGE_nginx-mod-ubus
		tristate "nginx-mod-ubus......................................... Nginx ubus module"
		default y if DEFAULT_nginx-mod-ubus
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libubus
		select PACKAGE_libblobmsg-json
		select PACKAGE_libjson-c
		select PACKAGE_nginx-ssl if PACKAGE_nginx-full<PACKAGE_nginx-mod-ubus
		select NGINX_UBUS
		help
		 Enable UBUS api support directly from the server.
		 http://nginx.org/
		 Thomas Heil <heil@terminal-consulting.de> Ansuel Smith <ansuelsmth@gmail.com>

	config PACKAGE_nginx-ssl
		tristate "nginx-ssl.............................. Nginx web server with SSL support"
		default y if DEFAULT_nginx-ssl
		default m if ALL
		select PACKAGE_libopenssl
		select PACKAGE_libpthread
		select PACKAGE_zlib if NGINX_HTTP_GZIP
		select PACKAGE_nginx-ssl-util-nopcre if !NGINX_PCRE
		select PACKAGE_libpcre if NGINX_PCRE
		select PACKAGE_libxml2 if NGINX_DAV
		select PACKAGE_libc
		select PACKAGE_nginx-ssl-util if NGINX_PCRE
		depends on m || (PACKAGE_nginx-full != y)
		help
		 nginx is an HTTP and reverse proxy server, as well as a mail proxy server, written by Igor Sysoev. This variant is compiled with SSL support enabled. To enable additional module select them in the nginx default configuration menu.
		 http://nginx.org/
		 Thomas Heil <heil@terminal-consulting.de> Ansuel Smith <ansuelsmth@gmail.com>


	
	  source "qca/feeds/packages/net/nginx/Config_ssl.in"

	config PACKAGE_nginx-ssl-util
		tristate "nginx-ssl-util............. Nginx configurator including SSL (using PCRE)"
		default y if DEFAULT_nginx-ssl-util
		default m if ALL
		select PACKAGE_libubus
		select PACKAGE_libc
		select PACKAGE_libpcre
		select PACKAGE_libopenssl
		select PACKAGE_libuci
		select PACKAGE_libpthread
		select PACKAGE_libstdcpp
		select PACKAGE_nginx-util
		select PACKAGE_libubox
		help
		 Utility that builds dynamically LAN listen directives for Nginx.
		   Furthermore, it manages SSL directives for its server parts and can create
		   corresponding (self-signed) certificates. It uses the PCRE library for performance.
		 Peter Stadler <peter.stadler@student.uibk.ac.at>

	config PACKAGE_nginx-ssl-util-nopcre
		tristate "nginx-ssl-util-nopcre... Nginx configurator including SSL (using <regex>)"
		default y if DEFAULT_nginx-ssl-util-nopcre
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libubus
		select PACKAGE_libopenssl
		select PACKAGE_libuci
		select PACKAGE_libpthread
		select PACKAGE_libubox
		select PACKAGE_nginx-util
		select PACKAGE_libstdcpp
		depends on m || (PACKAGE_nginx-ssl-util != y)
		help
		 Utility that builds dynamically LAN listen directives for Nginx.
		   Furthermore, it manages SSL directives for its server parts and can create
		   corresponding (self-signed) certificates. It uses the standard regex library of C++.
		 Peter Stadler <peter.stadler@student.uibk.ac.at>

	config PACKAGE_polipo
		tristate "polipo............................................... A caching web proxy"
		default y if DEFAULT_polipo
		default m if ALL
		select PACKAGE_libc
		help
		 Polipo is a small and fast caching web proxy (a web cache, an HTTP proxy,
		  a proxy server). While Polipo was designed to be used by one person or a
		  small group of people, there is nothing that prevents it from being used
		  by a larger group.
		 http://www.pps.univ-paris-diderot.fr/~jch/software/polipo/
		 Gabriel Kerneis <gabriel@kerneis.info>

	menuconfig PACKAGE_privoxy
		tristate "privoxy................................................ Privoxy WEB Proxy"
		default y if DEFAULT_privoxy
		default m if ALL
		select PACKAGE_zlib if !PRIVOXY_no_zlib
		select PACKAGE_libc
		select PACKAGE_libpcre if !PRIVOXY_no_pcre
		select PACKAGE_libpthread if !PRIVOXY_no_pthread
		help
		 Privoxy WEB Proxy - Homepage: www.privoxy.org
		 http://www.privoxy.org/
		 


	
		help
			Privoxy is a web proxy with advanced filtering capabilities for protecting
			privacy, modifying web page content, managing cookies, controlling access,
			and removing ads, banners, pop-ups and other obnoxious Internet junk. 
			Privoxy has a very flexible configuration and can be customized to suit
			individual needs and tastes. 
			Privoxy has application for both stand-alone systems and multi-user networks.
			Run as : privoxy=8118:privoxy=8118
			Version: 3.0.33-4
			Home   : http://www.privoxy.org/
	
		source "qca/feeds/packages/net/privoxy/Config.in"

	config PACKAGE_radicale
		tristate "radicale.................................. Radicale CalDAV/CardDAV server"
		default y if DEFAULT_radicale
		default m if ALL
		select PACKAGE_python3-codecs
		select PACKAGE_libc
		select PACKAGE_python3-xml
		select PACKAGE_python3-logging
		select PACKAGE_python3-light
		select PACKAGE_python3-urllib
		select PACKAGE_python3-openssl
		help
		 The Radicale Project is a CalDAV (calendar) and CardDAV (contact) server.  It
		   aims to be a light solution, easy to use, easy to install, easy to configure.
		   As a consequence, it requires few software dependances and is pre-configured to
		   work out-of-the-box.
		 https://radicale.org/
		 

	config PACKAGE_radicale-src
		tristate "radicale-src.................... Radicale CalDAV/CardDAV server (sources)"
		default y if DEFAULT_radicale-src
		default m if ALL
		select PACKAGE_libc
		help
		 The Radicale Project is a CalDAV (calendar) and CardDAV (contact) server.  It
		   aims to be a light solution, easy to use, easy to install, easy to configure.
		   As a consequence, it requires few software dependances and is pre-configured to
		   work out-of-the-box.
		 
		     This package contains the Python source files for radicale.
		 https://radicale.org/
		 


	
	    depends on PACKAGE_radicale

	config PACKAGE_radicale2
		tristate "radicale2............................. Radicale 2.x CalDAV/CardDAV server"
		default y if DEFAULT_radicale2
		default m if ALL
		select PACKAGE_python3
		select PACKAGE_python3-dateutil
		select PACKAGE_libc
		select PACKAGE_python3-setuptools
		select PACKAGE_python3-vobject
		depends on m || (PACKAGE_radicale != y)
		help
		 The Radicale Project is a CalDAV (calendar) and CardDAV (contact) server. It aims to be a light solution, easy to use, easy to install, easy to configure. As a consequence, it requires few software dependances and is pre-configured to work out-of-the-box.
		 
		 The Radicale Project runs on most of the UNIX-like platforms (Linux, BSD, MacOS X) and Windows. It is known to work with Evolution, Lightning, iPhone and Android clients. It is free and open-source software, released under GPL version 3.
		 
		 This package contains the python files.
		 
		 Note that md5 encryption of passwords requires passlib, and
		 bcrypt encryption requires passlib + bcrypt.  These are not
		 added as hard dependencies as users may be running radicale2
		 with a web server doing the authentication instead of radicale2.
		 
		 https://radicale.org/
		 

	config PACKAGE_radicale2-examples
		tristate "radicale2-examples........................... Radicale v2 example configs"
		default y if DEFAULT_radicale2-examples
		default m if ALL
		select PACKAGE_libc
		help
		 The Radicale Project is a CalDAV (calendar) and CardDAV (contact) server. It aims to be a light solution, easy to use, easy to install, easy to configure. As a consequence, it requires few software dependances and is pre-configured to work out-of-the-box.
		 
		 The Radicale Project runs on most of the UNIX-like platforms (Linux, BSD, MacOS X) and Windows. It is known to work with Evolution, Lightning, iPhone and Android clients. It is free and open-source software, released under GPL version 3.
		 .
		 This package contains upstream configs for example purposes.
		 https://radicale.org/
		 

	config PACKAGE_radicale2-src
		tristate "radicale2-src............... Radicale 2.x CalDAV/CardDAV server (sources)"
		default y if DEFAULT_radicale2-src
		default m if ALL
		select PACKAGE_libc
		help
		 The Radicale Project is a CalDAV (calendar) and CardDAV (contact) server. It aims to be a light solution, easy to use, easy to install, easy to configure. As a consequence, it requires few software dependances and is pre-configured to work out-of-the-box.
		 
		 The Radicale Project runs on most of the UNIX-like platforms (Linux, BSD, MacOS X) and Windows. It is known to work with Evolution, Lightning, iPhone and Android clients. It is free and open-source software, released under GPL version 3.
		 
		 This package contains the python files.
		 
		 Note that md5 encryption of passwords requires passlib, and
		 bcrypt encryption requires passlib + bcrypt.  These are not
		 added as hard dependencies as users may be running radicale2
		 with a web server doing the authentication instead of radicale2.
		 
		 
		     This package contains the Python source files for radicale2.
		 https://radicale.org/
		 


	
	    depends on PACKAGE_radicale2

	config PACKAGE_shadow-tls
		tristate "shadow-tls.......... A proxy to expose real tls handshake to the firewall"
		default y if DEFAULT_shadow-tls
		default m if ALL
		depends on (aarch64||arm||x86_64)
		select PACKAGE_libc
		help
		 A proxy to expose real tls handshake to the firewall.
		 
		   It works like trojan but it does not require signing certificate.
		   The firewall will see real tls handshake with valid certificate
		   that you choose.
		 https://github.com/ihciah/shadow-tls
		 Tianling Shen <cnsztl@immortalwrt.org>

