	menuconfig PACKAGE_libfaad2
		tristate "libfaad2......................... Freeware Advanced Audio Decoder library"
		default y if DEFAULT_libfaad2
		default m if ALL
		select PACKAGE_libc
		help
		 FAAD2 is the fastest ISO AAC audio decoder available.
		 	FAAD2 correctly decodes all MPEG-4 and MPEG-2 MAIN,
		 	LOW, LTP, LD and ER object type AAC files.
		   This package contains the library.
		 http://www.audiocoding.com/faad2.html
		 Ted Hess <thess@kitschensync.net>

