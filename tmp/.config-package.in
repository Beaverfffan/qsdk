	config PACKAGE_xxd
		tristate "xxd..................................... make a hexdump or do the reverse"
		default y if DEFAULT_xxd
		default m if ALL
		select PACKAGE_libc
		help
		 xxd creates a hex dump of a given file or standard input, it can also convert
		  a hex dump back to its original binary form.
		 http://www.vim.org/
		 Marko Ratkaj <markoratkaj@gmail.com>

	config PACKAGE_xxhash
		tristate "xxhash..................................... Extremely fast hash algorithm"
		default y if DEFAULT_xxhash
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libxxhash
		help
		 xxHash is an Extremely fast Hash algorithm, running at RAM speed
		   limits. It successfully completes the SMHasher test suite which
		   evaluates collision, dispersion and randomness qualities of hash
		   functions. Code is highly portable, and hashes are identical on all
		   platforms (little / big endian).
		 
		   This package contains the executables.
		 https://cyan4973.github.io/xxHash/
		 Julien Malik <julien.malik@paraiso.me>

