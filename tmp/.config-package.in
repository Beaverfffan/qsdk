menu "OpenLDAP"
	menuconfig PACKAGE_libopenldap
		tristate "libopenldap............................. LDAP directory suite (libraries)"
		default y if DEFAULT_libopenldap
		default m if ALL
		select PACKAGE_libdb47 if OPENLDAP_DB47
