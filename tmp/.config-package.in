	config PACKAGE_zabbix-extra-mac80211
		tristate "zabbix-extra-mac80211....... Zabbix discovery/userparameters for mac80211"
		default y if DEFAULT_zabbix-extra-mac80211
		default m if ALL
		select PACKAGE_libc
		depends on KERNEL_DEBUG_FS
		select PACKAGE_zabbix-agentd if PACKAGE_zabbix-agentd-openssl<PACKAGE_zabbix-extra-mac80211&&PACKAGE_zabbix-agentd-gnutls<PACKAGE_zabbix-extra-mac80211
		depends on PACKAGE_MAC80211_DEBUGFS
		help
		 An extra package for zabbix-agentd that adds a discovery rule for mac80211 wifi phy and many userparameters.
		 It contains an suid helper to allow zabbix-agentd to still run as zabbix user and not as root.
		 See https://openwrt.org/docs/guide-user/services/network_monitoring/zabbix for ready to use zabbix templates.
		 https://www.zabbix.com/
		 Etienne CHAMPETIER <champetier.etienne@gmail.com>

	config PACKAGE_zabbix-extra-network
		tristate "zabbix-extra-network......... Zabbix discovery/userparameters for network"
		default y if DEFAULT_zabbix-extra-network
		default m if ALL
		select PACKAGE_lua
		select PACKAGE_libubus-lua
		select PACKAGE_zabbix-agentd if PACKAGE_zabbix-agentd-openssl<PACKAGE_zabbix-extra-network&&PACKAGE_zabbix-agentd-gnutls<PACKAGE_zabbix-extra-network
		select PACKAGE_libc
		help
		 An extra package for zabbix-agentd that adds a discovery rule for openwrt network interfaces.
		 The idea here is to discover only interfaces listed in /etc/config/network (discover br-lan and not eth0.1 and wlan0)
		 See https://openwrt.org/docs/guide-user/services/network_monitoring/zabbix for ready to use zabbix templates.
		 https://www.zabbix.com/
		 Etienne CHAMPETIER <champetier.etienne@gmail.com>

	config PACKAGE_zabbix-extra-wifi
		tristate "zabbix-extra-wifi............... Zabbix discovery/userparameters for wifi"
		default y if DEFAULT_zabbix-extra-wifi
		default m if ALL
		select PACKAGE_libiwinfo-lua
		select PACKAGE_libc
		select PACKAGE_zabbix-agentd if PACKAGE_zabbix-agentd-openssl<PACKAGE_zabbix-extra-wifi&&PACKAGE_zabbix-agentd-gnutls<PACKAGE_zabbix-extra-wifi
		select PACKAGE_libubus-lua
		select PACKAGE_lua
		help
		 An extra package for zabbix-agentd that adds a discovery rule for wifi interfaces and many userparameters.
		 As it uses libiwinfo, it works with all wifi devices supported by openwrt.
		 See https://openwrt.org/docs/guide-user/services/network_monitoring/zabbix for ready to use zabbix templates.
		 https://www.zabbix.com/
		 Etienne CHAMPETIER <champetier.etienne@gmail.com>

