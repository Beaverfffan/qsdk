		select PACKAGE_librt
		select PACKAGE_libsndfile
		select PACKAGE_libltdl
		depends on m || (PACKAGE_pulseaudio-daemon-avahi != y)
		help
		 PulseAudio (formerly Polypaudio) is a cross-platform, networked sound server.
		 https://www.freedesktop.org/wiki/Software/PulseAudio/
		 Peter Wagner <tripolar@gmx.at>

	config PACKAGE_pulseaudio-daemon-avahi
