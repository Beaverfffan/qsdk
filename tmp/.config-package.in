		select PACKAGE_liblo
		help
		 Lightweight Open Sound Control (OSC) utilities
		 http://liblo.sourceforge.net/
		 

	config PACKAGE_madplay
		tristate "madplay.......................... MPEG audio player in fixed point - ALSA"
		default y if DEFAULT_madplay
		default m if ALL
		depends on AUDIO_SUPPORT
		select PACKAGE_libintl-full if BUILD_NLS
		select PACKAGE_alsa-lib
		select PACKAGE_libc
		select PACKAGE_libid3tag
		select PACKAGE_libmad
		help
		 MAD is an MPEG audio decoder. It currently only supports the MPEG 1
		 	standard, but fully implements all three audio layers (Layer I, Layer II,
		 	and Layer III, the latter often colloquially known as MP3.). There is also
		 	full support for ID3 tags.
		 https://sourceforge.net/projects/mad
		 Simon Peter <probono@puredarwin.org>

	config PACKAGE_moc
		tristate "moc..................................................... Music On Console"
		default y if DEFAULT_moc
		default m if ALL
		select PACKAGE_libdb47
		select PACKAGE_libflac
		select PACKAGE_libltdl
		depends on AUDIO_SUPPORT
		select PACKAGE_libcurl
		select PACKAGE_libsamplerate
		select PACKAGE_libc
		select PACKAGE_libvorbis
		select PACKAGE_libncurses
		select PACKAGE_libmad
		select PACKAGE_libmagic
		select PACKAGE_libfaad2
		select PACKAGE_libiconv-full if BUILD_NLS
		select PACKAGE_libid3tag
		select PACKAGE_alsa-lib
		help
		 MOC (music on console) is a console audio player for LINUX/UNIX designed to be powerful and easy to use.
		 https://moc.daper.net/
		 Ted Hess <thess@kitschensync.net>

	config PACKAGE_mpc
		tristate "mpc................................... Music Player Daemon Console Client"
		default y if DEFAULT_mpc
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libmpdclient
		help
		 MPD is a music player supporting flac, mp3 and ogg files.
		 	It is typically controlled over a network using one of it's many
		 	clients including mpc(console), gmpc(gnome), phpmp(php) etc.
		 	this is MPC
		 http://www.musicpd.org/
		 Ted Hess <thess@kitschensync.net>

	config PACKAGE_mpd-avahi-service
		tristate "mpd-avahi-service.................... Music Player Daemon (Avahi service)"
		default y if DEFAULT_mpd-avahi-service
		default m if ALL
		select PACKAGE_libmpdclient
		select PACKAGE_libexpat
		select PACKAGE_libid3tag
		select PACKAGE_libiconv-full if BUILD_NLS
		select PACKAGE_libfaad2
		select PACKAGE_avahi-dbus-daemon
		select PACKAGE_libflac
		select PACKAGE_alsa-lib if AUDIO_SUPPORT
		select PACKAGE_libfmt
		select PACKAGE_libpthread
		select PACKAGE_zlib
		select PACKAGE_libopus
		select PACKAGE_libc
		select PACKAGE_libcurl
		select PACKAGE_boost
		help
		 Music Player Daemon (MPD) is a flexible, powerful, server-side
		  application for playing music. It is typically controlled over a
		  network using one of it's many clients including mpc (console),
		  gmpc (gnome), phpmp (php), etc...
		  .
		  This package contains the service definition for announcing the
		  Music Player Daemon service via mDNS/DNS-SD.
		 https://www.musicpd.org/
		 

	config PACKAGE_mpd-full
		tristate "mpd-full...................................... Music Player Daemon (full)"
		default y if DEFAULT_mpd-full
		default m if ALL
		select PACKAGE_alsa-lib if AUDIO_SUPPORT
		select PACKAGE_libpthread
		depends on !(AUDIO_SUPPORT && PACKAGE_pulseaudio-daemon-avahi<PACKAGE_mpd-full) || AUDIO_SUPPORT
		select PACKAGE_zlib
		select PACKAGE_yajl
		select PACKAGE_libshout
		select PACKAGE_libflac
		select PACKAGE_libmms
		select PACKAGE_boost
		select PACKAGE_libmad if !BUILD_PATENTED
		select PACKAGE_libiconv-full if BUILD_NLS
		select PACKAGE_libfaad2
		select PACKAGE_libfmt
		select PACKAGE_pulseaudio-daemon if AUDIO_SUPPORT && PACKAGE_pulseaudio-daemon-avahi<PACKAGE_mpd-full
		select PACKAGE_libsoxr
		select PACKAGE_lame-lib
		select PACKAGE_libnpupnp
		select PACKAGE_libvorbis
		select PACKAGE_libopus
		select PACKAGE_libc
		select PACKAGE_libcurl
		select PACKAGE_libexpat
		select PACKAGE_libmpdclient
		select PACKAGE_libffmpeg-audio-dec if PACKAGE_libffmpeg-full<PACKAGE_mpd-full&&PACKAGE_libffmpeg-mini<PACKAGE_mpd-full&&PACKAGE_libffmpeg-custom<PACKAGE_mpd-full
		select PACKAGE_libid3tag
		help
		 Music Player Daemon (MPD) is a flexible, powerful, server-side
		  application for playing music. It is typically controlled over a
		  network using one of it's many clients including mpc (console),
		  gmpc (gnome), phpmp (php), etc...
		  .
		  This package contains a full-blown Music Player Daemon.
		 https://www.musicpd.org/
		 

	config PACKAGE_mpd-mini
		tristate "mpd-mini...................................... Music Player Daemon (mini)"
		default y if DEFAULT_mpd-mini
		default m if ALL
		select PACKAGE_boost
		select PACKAGE_libvorbisidec
		select PACKAGE_libcurl
		select PACKAGE_libc
		select PACKAGE_libopus
		select PACKAGE_zlib
		select PACKAGE_alsa-lib if AUDIO_SUPPORT
		select PACKAGE_libfmt
		select PACKAGE_libpthread
		select PACKAGE_libflac
		select PACKAGE_libfaad2
		select PACKAGE_libiconv-full if BUILD_NLS
		select PACKAGE_libid3tag
		select PACKAGE_libexpat
		select PACKAGE_libmad
		select PACKAGE_libmpdclient
		help
		 Music Player Daemon (MPD) is a flexible, powerful, server-side
		  application for playing music. It is typically controlled over a
		  network using one of it's many clients including mpc (console),
		  gmpc (gnome), phpmp (php), etc...
		  .
		  This package contains a minimal Music Player Daemon, with support for
		  only FLAC, AAC, MP3 & OGG media types & only file: & http: protocols.
		 https://www.musicpd.org/
		 

