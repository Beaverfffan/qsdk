	config PACKAGE_owntone
		tristate "owntone................ iTunes (DAAP) server for Apple Remote and AirPlay"
		default y if DEFAULT_owntone
		default m if ALL
		select PACKAGE_libgpg-error
		select PACKAGE_libc
		select PACKAGE_libcurl
		depends on AUDIO_SUPPORT
		select PACKAGE_zlib
		select PACKAGE_libavahi-client
		select PACKAGE_libunistring
		select PACKAGE_libjson-c
		select PACKAGE_libgdbm
		select PACKAGE_alsa-lib
		depends on !(PACKAGE_libx264) || BUILD_PATENTED
		select PACKAGE_confuse
		select PACKAGE_libplist
		select PACKAGE_libffmpeg-full
		select PACKAGE_libiconv-full if BUILD_NLS
		select PACKAGE_libevent2
		select PACKAGE_libprotobuf-c
		select PACKAGE_libdaemon
		select PACKAGE_libgcrypt
		select PACKAGE_libuuid
		select PACKAGE_libgnutls
		select PACKAGE_mxml
		select PACKAGE_libexpat
		select PACKAGE_libsodium
		select PACKAGE_sqlite3-cli
		select PACKAGE_libwebsockets-mbedtls if PACKAGE_libwebsockets-full<PACKAGE_owntone
		help
		 OwnTone is a Linux/FreeBSD DAAP (iTunes), MPD (Music Player Daemon) and
		   RSP (Roku) media server. It has support for AirPlay speakers, Chromecast,
		   Apple Remote (and compatibles), MPD clients, Spotify, internet radio and
		   LastFM. It does not support AirPlay/Chromecast video.
		 https://github.com/owntone/owntone-server
		 Espen Jürgensen <espenjurgensen+openwrt@gmail.com>

	config PACKAGE_pianod
		tristate "pianod.............................................. Pandora radio daemon"
		default y if DEFAULT_pianod
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libgcrypt
		select PACKAGE_libfaad2
		select PACKAGE_libmpg123
		select PACKAGE_libmbedtls
		select PACKAGE_libjson-c
		select PACKAGE_libpthread
		depends on AUDIO_SUPPORT
		select PACKAGE_libao
		help
		 pianod is a Pandora music player client with line-oriented and Websocket control interfaces.
		   A simple protocol makes for easy clients, mix scripting, integration with a
		   home automation system, use as multiple-user music system for home or office.
		   Documentation and configuration information can be found at:
		       http://deviousfish.com/pianod1/
		 http://deviousfish.com/pianod1/
		 Ted Hess <thess@kitschensync.net>

	config PACKAGE_pianod-client
		tristate "pianod-client................................. Pandora radio daemon WebUI"
		default y if DEFAULT_pianod-client
		default m if ALL
		select PACKAGE_libc
		depends on AUDIO_SUPPORT
		select PACKAGE_pianod
		help
		 Web client UI and remote player viewer for pianod
		   Examples --- (Note: The viewer.* files need not be on the pianod host)
		   Main interface: http://pianod-host:4446/pianod
		   Remote viewer: file:///<path>/viewer.html?server=pianod-host:4446  --or--
		                  http://pianod-host:4446/pianod/viewer.html?server=pianod-host:4446
		 http://deviousfish.com/pianod1/
		 Ted Hess <thess@kitschensync.net>

	config PACKAGE_portaudio
		tristate "portaudio.............................. Portable cross-platform audio I/O"
		default y if DEFAULT_portaudio
		default m if ALL
		select PACKAGE_libc
		depends on AUDIO_SUPPORT
		select PACKAGE_libpthread
		select PACKAGE_librt
		select PACKAGE_alsa-lib
		help
		 PortAudio is a free, cross-platform, open-source, audio I/O library.  It lets
		  you write simple audio programs in 'C' or C++ that will compile and run on many
		  platforms including Windows, Macintosh OS X, and Unix (OSS/ALSA). It is
		  intended to promote the exchange of audio software between developers on
		  different platforms. Many applications use PortAudio for Audio I/O.
		 http://www.portaudio.com/
		 

