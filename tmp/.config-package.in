		default y if DEFAULT_libupm-a110x-python3
		default m if ALL
		select PACKAGE_libmraa-python3
		depends on !arc
		select PACKAGE_libc
		select PACKAGE_libmraa
		depends on !powerpc
		depends on !armeb
		depends on !riscv64
		select PACKAGE_python3-light
		select PACKAGE_libupm-a110x
		select PACKAGE_librt
