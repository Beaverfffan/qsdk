	config PACKAGE_ipvsadm
		tristate "ipvsadm.......................... IP Virtual Server Configuration Manager"
		default y if DEFAULT_ipvsadm
		default m if ALL
		depends on IPV6
		select PACKAGE_libpopt
		select PACKAGE_kmod-nf-ipvs
		select PACKAGE_libc
		select PACKAGE_libnl-genl
		help
		 IPVS (IP Virtual Server) implements transport-layer load balancing
		   inside the Linux kernel, so called Layer-4 switching. The command line tool
		   ipvsadm is used to set up, maintain or inspect the virtual server table
		   in the Linux kernel. The Linux Virtual Server can be used to build scalable
		   network services based on a cluster of two or more nodes.
		 http://www.linuxvirtualserver.org
		 Mauro Mozzarelli <mauro@ezplanet.org>, Florian Eckert <fe@dev.tdt.de>

	config PACKAGE_irtt
		tristate "irtt................................................................ irtt"
		default y if DEFAULT_irtt
