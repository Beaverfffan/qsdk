menu "Instant Messaging"
	config PACKAGE_bitlbee
		tristate "bitlbee............................ An IRC to other chat networks gateway"
		default y if DEFAULT_bitlbee
		default m if ALL
		select PACKAGE_libiconv-full if BUILD_NLS
		select PACKAGE_glib2
		select PACKAGE_libc
		select PACKAGE_libintl-full if BUILD_NLS
		select PACKAGE_libopenssl
		help
		 This program can be used as an IRC server which forwards everything you
		 	say to people on other chat networks: Jabber (which includes Google Talk
		 	and Facebook Chat), ICQ, AIM, MSN, Yahoo! and Twitter/Identica/Status.net.
		 https://www.bitlbee.org/
		 Nikil Mehta <nikil.mehta@gmail.com>

