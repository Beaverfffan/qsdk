	config PACKAGE_conmon
		tristate "conmon..................................................... Podman conmon"
		default y if DEFAULT_conmon
		default m if ALL
		select PACKAGE_libintl-full if BUILD_NLS
		select PACKAGE_libc
		select PACKAGE_glib2
		depends on !arc
		select PACKAGE_libiconv-full if BUILD_NLS
		help
		 An OCI container runtime monitor.
		 
		   Conmon is a monitoring program and communication tool between
		   a container manager (like Podman or CRI-O) and an OCI runtime
		   (like runc or crun) for a single container.
		 https://podman.io
		 Oskari Rauta <oskari.rauta@gmail.com>

	menuconfig PACKAGE_containerd
		tristate "containerd.................................. containerd container runtime"
		default y if DEFAULT_containerd
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_runc
		depends on (aarch64||arm||i386||i686||mips||mips64||mips64el||mipsel||powerpc64||riscv64||x86_64)
		select PACKAGE_btrfs-progs
		help
		 An industry-standard container runtime with an emphasis on simplicity, robustness and portability
		 https://containerd.io/
		 Gerard Ryan <G.M0N3Y.2503@gmail.com>

	config PACKAGE_coremark
		tristate "coremark...................... CoreMark Embedded Microprocessor Benchmark"
		default y if DEFAULT_coremark
		default m if ALL
		select PACKAGE_libc
		help
		 Embedded Microprocessor Benchmark
		 https://github.com/eembc/coremark
		 Lim Guo Wei <limguowei@gmail.com> Aleksander Jan Bajkowski <olek2@wp.pl>


	
		config COREMARK_OPTIMIZE_O3
			bool "Use all optimizations (-O3)"
			depends on PACKAGE_coremark
			default y
			help
				This enables additional optmizations using the -O3 compilation flag.
	
		config COREMARK_ENABLE_MULTITHREADING
			bool "Enable multithreading support"
			depends on PACKAGE_coremark
			default n
			help
				This enables multithreading support
	
		config COREMARK_NUMBER_OF_THREADS
			int "Number of threads"
			depends on COREMARK_ENABLE_MULTITHREADING
			default 2
			help
				Number of threads to run in parallel

	menuconfig PACKAGE_coreutils
