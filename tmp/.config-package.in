	config PACKAGE_which
		tristate "which....................................... which utility - full version"
		default y if DEFAULT_which
		default m if ALL
		select PACKAGE_libc
		help
		 The which command shows the full pathname of a specified program, if the specified program is in your PATH.
		 https://carlowood.github.io/which/
		 Huangbin Zhan <zhanhb88@gmail.com>

	config PACKAGE_whiptail
		tristate "whiptail......................... Display dialog boxes from shell scripts"
		default y if DEFAULT_whiptail
		default m if ALL
		select PACKAGE_libpopt
		select PACKAGE_libnewt
		select PACKAGE_libslang2
		select PACKAGE_libc
		help
		 A lightweight replacement for the dialog command (dialog boxes from shell
