		depends on PACKAGE_strongswan
		depends on !(PACKAGE_iptables-zz-legacy<PACKAGE_strongswan-mod-updown && IPV6) || IPV6
		select PACKAGE_ip6tables-nft if IPV6 && PACKAGE_ip6tables-zz-legacy<PACKAGE_strongswan-mod-updown
