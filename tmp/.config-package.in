		depends on !(PACKAGE_kmod-qca-nss-ecm-noload && TARGET_ipq_ipq807x_64 && PACKAGE_kmod-qca-nss-gmac) || TARGET_ipq806x||TARGET_ipq_ipq806x
		depends on !(PACKAGE_kmod-qca-nss-ecm-standard && TARGET_ipq806x && PACKAGE_kmod-qca-nss-gmac) || !LINUX_3_18
		depends on !(PACKAGE_kmod-qca-nss-ecm-noload && TARGET_ipq_ipq60xx && PACKAGE_kmod-qca-nss-dp) || TARGET_ipq807x
		depends on !(PACKAGE_kmod-qca-nss-ecm-standard && TARGET_ipq807x && PACKAGE_kmod-qca-nss-gmac) || TARGET_ipq806x||TARGET_ipq_ipq806x
		depends on !(PACKAGE_kmod-qca-nss-ecm-noload && TARGET_ipq807x) || TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx
		depends on !(PACKAGE_kmod-qca-nss-ecm-standard && TARGET_ipq53xx && TARGET_ipq95xx) || (TARGET_ipq807x)
		depends on !(PACKAGE_kmod-qca-nss-ecm-premium && PACKAGE_kmod-qca-nss-ecm-premium-noload<PACKAGE_kmod-qca-nss-ecm-wifi-plugin && TARGET_ipq50xx && PACKAGE_kmod-qca-nss-gmac) || !LINUX_3_18
		depends on !(PACKAGE_kmod-qca-nss-ecm-noload && TARGET_ipq95xx && TARGET_ipq53xx) || TARGET_ipq807x
		depends on !(PACKAGE_kmod-qca-nss-ecm-standard && TARGET_ipq95xx && TARGET_ipq53xx) || TARGET_ipq807x
		depends on !(PACKAGE_kmod-qca-nss-ecm-standard && TARGET_ipq53xx && TARGET_ipq53xx) || TARGET_ipq807x
		depends on !(PACKAGE_kmod-qca-nss-ecm-premium && PACKAGE_kmod-qca-nss-ecm-premium-noload<PACKAGE_kmod-qca-nss-ecm-wifi-plugin && TARGET_ipq95xx && PACKAGE_kmod-qca-ovsmgr) || !LINUX_3_18
		depends on !(PACKAGE_kmod-qca-nss-ecm-noload && TARGET_ipq_ipq50xx_64 && PACKAGE_kmod-qca-nss-dp) || (TARGET_ipq807x)
		depends on !(PACKAGE_kmod-qca-nss-ecm-noload && TARGET_ipq_ipq806x) || TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx
		depends on !(PACKAGE_kmod-qca-nss-ecm-premium && PACKAGE_kmod-qca-nss-ecm-premium-noload<PACKAGE_kmod-qca-nss-ecm-wifi-plugin && TARGET_ipq_ipq50xx_64 && PACKAGE_kmod-qca-nss-gmac) || !LINUX_3_18
		depends on !(PACKAGE_kmod-qca-nss-ecm-standard && TARGET_ipq53xx && TARGET_ipq53xx) || (TARGET_ipq807x)
		depends on !(PACKAGE_kmod-qca-nss-ecm-standard && TARGET_ipq806x) || !LINUX_3_18
		depends on !(PACKAGE_kmod-qca-nss-ecm-standard && TARGET_ipq_ipq50xx_64 && PACKAGE_kmod-qca-nss-dp) || TARGET_ipq807x
		depends on !(PACKAGE_kmod-qca-nss-ecm-premium && PACKAGE_kmod-qca-nss-ecm-premium-noload<PACKAGE_kmod-qca-nss-ecm-wifi-plugin && TARGET_ipq95xx && TARGET_ipq53xx) || TARGET_ipq807x
		depends on !(PACKAGE_kmod-qca-nss-ecm-noload && TARGET_ipq_ipq60xx_64 && PACKAGE_kmod-qca-nss-gmac) || TARGET_ipq806x||TARGET_ipq_ipq806x
		depends on !(PACKAGE_kmod-qca-nss-ecm-noload && TARGET_ipq53xx && TARGET_ipq53xx) || (TARGET_ipq807x)
		help
		 (with no-nss for host mode) (with no-nss for host mode)
		 

	config PACKAGE_kmod-qca8k
		tristate "kmod-qca8k..................................... Kernel driver for QCA DSA"
		default y if DEFAULT_kmod-qca8k
		default m if ALL||ALL_NONSHARED||ALL_KMODS
		depends on TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq_ipq50xx_64||TARGET_ipq_ipq50xx||TARGET_ipq50xx||TARGET_ipq53xx
		help
		 Kernel driver for QCA DSA
		 

	config PACKAGE_kmod-telemetry-agent
		tristate "kmod-telemetry-agent..................................... Telemetry Agent"
		default y if DEFAULT_kmod-telemetry-agent
		default m if ALL||ALL_NONSHARED||ALL_KMODS
		depends on PACKAGE_kmod-ath12k
		help
		 This package contains telemetry agent support for open source profile.
		 

	config PACKAGE_kmod-usb-phy-ipq5018
		tristate "kmod-usb-phy-ipq5018..................... DWC3 USB PHY driver for IPQ5018"
		default y if DEFAULT_kmod-usb-phy-ipq5018
		default m if ALL||ALL_NONSHARED||ALL_KMODS
		depends on TARGET_ipq50xx||TARGET_ipq53xx
		help
		 This driver provides support for the USB PHY drivers
		  within the IPQ5018 SoCs.
		 

endmenu

menu "Languages"

menu "Erlang"
	config PACKAGE_erlang
		tristate "erlang................................... Erlang/OTP programming language"
		default y if DEFAULT_erlang
		default m if ALL
		select PACKAGE_libncurses
		select PACKAGE_librt
		select PACKAGE_zlib
		select PACKAGE_libc
		select PACKAGE_libstdcpp
		help
		 Erlang/OTP is a general-purpose programming language and runtime
		  environment. Erlang has built-in support for concurrency, distribution
		  and fault tolerance.
		  .
		  This package contains the runtime implementation and a minimal set of
		  modules (erts, kernel, sasl & stdlib).
		 http://www.erlang.org/
		 Arnaud Sautaux <arnaud.sautaux@infoteam.ch>

	config PACKAGE_erlang-asn1
		tristate "erlang-asn1................. Abstract Syntax Notation One (ASN.1) support"
		default y if DEFAULT_erlang-asn1
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_erlang
		select PACKAGE_erlang-syntax-tools
		help
		 Erlang/OTP is a general-purpose programming language and runtime
		  environment. Erlang has built-in support for concurrency, distribution
		  and fault tolerance.
		  .
		  This Erlang/OTP package provides Abstract Syntax Notation One (ASN.1)
		  support.
		 http://www.erlang.org/
		 Arnaud Sautaux <arnaud.sautaux@infoteam.ch>

	config PACKAGE_erlang-compiler
		tristate "erlang-compiler....................................... Byte code compiler"
		default y if DEFAULT_erlang-compiler
		default m if ALL
		select PACKAGE_erlang
		select PACKAGE_libc
		help
		 Erlang/OTP is a general-purpose programming language and runtime
		  environment. Erlang has built-in support for concurrency, distribution
		  and fault tolerance.
		  .
		  This Erlang/OTP package provides a byte code compiler for Erlang which
		  produces highly compact code.
		 http://www.erlang.org/
		 Arnaud Sautaux <arnaud.sautaux@infoteam.ch>

	config PACKAGE_erlang-crypto
		tristate "erlang-crypto....................................... Cryptography support"
		default y if DEFAULT_erlang-crypto
		default m if ALL
		select PACKAGE_libopenssl
		select PACKAGE_libc
		select PACKAGE_erlang
		help
		 Erlang/OTP is a general-purpose programming language and runtime
		  environment. Erlang has built-in support for concurrency, distribution
		  and fault tolerance.
		  .
		  This Erlang/OTP package provides functions for computation of message
		  digests, and encryption and decryption functions.
		 http://www.erlang.org/
		 Arnaud Sautaux <arnaud.sautaux@infoteam.ch>

	config PACKAGE_erlang-erl-interface
		tristate "erlang-erl-interface........................ Erlang erl_interface support"
		default y if DEFAULT_erlang-erl-interface
		default m if ALL
		select PACKAGE_erlang
		select PACKAGE_libc
		help
		 Erlang/OTP is a general-purpose programming language and runtime
		  environment. Erlang has built-in support for concurrency, distribution
		  and fault tolerance.
		  .
		  This Erlang/OTP package provides support for erlang interoperability with other languages.
		 http://www.erlang.org/
		 Arnaud Sautaux <arnaud.sautaux@infoteam.ch>

	config PACKAGE_erlang-inets
		tristate "erlang-inets................................ Internet clients and servers"
		default y if DEFAULT_erlang-inets
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_erlang
		help
		 Erlang/OTP is a general-purpose programming language and runtime
		  environment. Erlang has built-in support for concurrency, distribution
		  and fault tolerance.
		  .
		  This Erlang/OTP package provides a container for Internet clients and
		  servers. Currently a FTP client, a HTTP client and server, and a tftp
		  client and server have been incorporated in Inets.
		 http://www.erlang.org/
		 Arnaud Sautaux <arnaud.sautaux@infoteam.ch>

	config PACKAGE_erlang-mnesia
		tristate "erlang-mnesia....................................... Distributed database"
		default y if DEFAULT_erlang-mnesia
		default m if ALL
		select PACKAGE_erlang
		select PACKAGE_libc
		help
		 Erlang/OTP is a general-purpose programming language and runtime
		  environment. Erlang has built-in support for concurrency, distribution
		  and fault tolerance.
		  .
		  This Erlang/OTP package provides a distributed DataBase Management
		  System (DBMS), appropriate for telecommunications applications and
		  other Erlang applications which require continuous operation and
		  exhibit soft real-time properties.
		 http://www.erlang.org/
		 Arnaud Sautaux <arnaud.sautaux@infoteam.ch>

	config PACKAGE_erlang-os_mon
		tristate "erlang-os_mon........................... Erlang OS Monitoring Application"
		default y if DEFAULT_erlang-os_mon
		default m if ALL
		select PACKAGE_erlang
		select PACKAGE_libc
		help
		 Erlang/OTP is a general-purpose programming language and runtime
		  environment. Erlang has built-in support for concurrency, distribution
		  and fault tolerance.
		  .
		  This Erlang/OTP package provides the following services:
		   cpu_sup CPU load and utilization supervision
		   disksup Disk supervision
		   memsup Memory supervision
		 http://www.erlang.org/
		 Arnaud Sautaux <arnaud.sautaux@infoteam.ch>

	config PACKAGE_erlang-public-key
		tristate "erlang-public-key..................................... Public Key support"
		default y if DEFAULT_erlang-public-key
		default m if ALL
		select PACKAGE_erlang-asn1
		select PACKAGE_erlang-crypto
		select PACKAGE_libc
		select PACKAGE_erlang
		help
		 Erlang/OTP is a general-purpose programming language and runtime
		  environment. Erlang has built-in support for concurrency, distribution
		  and fault tolerance.
		  .
		  This Erlang/OTP package provides functions to handle public-key infrastructure.
		 http://www.erlang.org/
		 Arnaud Sautaux <arnaud.sautaux@infoteam.ch>

	config PACKAGE_erlang-reltool
		tristate "erlang-reltool.................................... Erlang reltool support"
		default y if DEFAULT_erlang-reltool
		default m if ALL
		select PACKAGE_erlang
		select PACKAGE_libc
		help
		 Erlang/OTP is a general-purpose programming language and runtime
		  environment. Erlang has built-in support for concurrency, distribution
		  and fault tolerance.
		  .
		  This Erlang/OTP package provides support for release management.
		 http://www.erlang.org/
		 Arnaud Sautaux <arnaud.sautaux@infoteam.ch>

	config PACKAGE_erlang-runtime-tools
		tristate "erlang-runtime-tools................. Low-profile debugging/tracing tools"
		default y if DEFAULT_erlang-runtime-tools
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_erlang
		help
		 Erlang/OTP is a general-purpose programming language and runtime
		  environment. Erlang has built-in support for concurrency, distribution
		  and fault tolerance.
		  .
		  This Erlang/OTP package provides low footprint tracing/debugging tools
		  suitable for inclusion in a production system.
		 http://www.erlang.org/
		 Arnaud Sautaux <arnaud.sautaux@infoteam.ch>

	config PACKAGE_erlang-snmp
		tristate "erlang-snmp............ Simple Network Management Protocol (SNMP) support"
		default y if DEFAULT_erlang-snmp
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_erlang
		select PACKAGE_erlang-asn1
		help
		 Erlang/OTP is a general-purpose programming language and runtime
		  environment. Erlang has built-in support for concurrency, distribution
