menu "BitTorrent"
	config PACKAGE_mktorrent
		tristate "mktorrent...................................................... mktorrent"
		default y if DEFAULT_mktorrent
		default m if ALL
		select PACKAGE_libc
		help
		 mktorrent
		 https://github.com/Rudde/mktorrent
		 Daniel Golle <daniel@makrotopia.org>

	config PACKAGE_opentracker
		tristate "opentracker.................................................. opentracker"
		default y if DEFAULT_opentracker
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libpthread
		select PACKAGE_zlib
		help
		 opentracker - An open and free bittorrent tracker
		 
		  opentracker is an open and free bittorrent tracker project.
		  It aims for minimal resource usage and is intended to run at your wlan router.
		  Currently it is deployed as an open and free tracker instance.
		  Read our free and open tracker blog and announce your torrents there
		  (but do not hesitate to setup your own free trackers!).
		 
		  This package contains the IPv4-build of opentracker.
		 
		 http://erdgeist.org/arts/software/opentracker/
		 Daniel Golle <daniel@makrotopia.org>

	config PACKAGE_opentracker6
