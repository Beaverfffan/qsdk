menu "Tcpreplay"
	config PACKAGE_tcpbridge
		tristate "tcpbridge................... Bridge network traffic across two interfaces"
		default y if DEFAULT_tcpbridge
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libdnet
		select PACKAGE_musl-fts if USE_MUSL
		select PACKAGE_libpcap
		select PACKAGE_librt
		help
		 tcpbridge is a tool for selectively briding network traffic across two
		   interfaces and optionally modifying the packets in between
		 http://tcpreplay.appneta.com/
		 Alexandru Ardelean <ardeleanalex@gmail.com>

	config PACKAGE_tcpcapinfo
		tristate "tcpcapinfo........... Pcap file dissector for debugging broken pcap files"
		default y if DEFAULT_tcpcapinfo
		default m if ALL
		select PACKAGE_librt
		select PACKAGE_musl-fts if USE_MUSL
		select PACKAGE_libc
		select PACKAGE_libdnet
		select PACKAGE_libpcap
		help
		 tcpcapinfo is a tool for decoding the structure of a pcap(3) file with a
		   focus on finding broken pcap files and determining how two related pcap
		   files might differ.
		 http://tcpreplay.appneta.com/
		 Alexandru Ardelean <ardeleanalex@gmail.com>

	config PACKAGE_tcpliveplay
		tristate "tcpliveplay"
		default y if DEFAULT_tcpliveplay
		default m if ALL
		select PACKAGE_librt
		select PACKAGE_libpcap
		select PACKAGE_libdnet
		select PACKAGE_libc
		select PACKAGE_musl-fts if USE_MUSL
		help
		 This program, 'tcpliveplay' replays a captured set of packets using new TCP
		   connections with the captured TCP payloads against a remote host in order
		   to do comprehensive vulnerability testings.
		 http://tcpreplay.appneta.com/
		 Alexandru Ardelean <ardeleanalex@gmail.com>

	config PACKAGE_tcpprep
		tristate "tcpprep................... Create a tcpreplay cache file from a pcap file"
		default y if DEFAULT_tcpprep
		default m if ALL
		select PACKAGE_librt
		select PACKAGE_libdnet
		select PACKAGE_libc
		select PACKAGE_musl-fts if USE_MUSL
		select PACKAGE_libpcap
		help
		 tcpprep is a ``pcap(3)'' file pre-processor which creates a cache file
		   which provides "rules" for ``tcprewrite(1)'' and ``tcpreplay(1)'' on how to
		   process and send packets.
		 http://tcpreplay.appneta.com/
		 Alexandru Ardelean <ardeleanalex@gmail.com>

	config PACKAGE_tcpreplay
		tristate "tcpreplay.................... Replay network traffic stored in pcap files"
		default y if DEFAULT_tcpreplay
		default m if ALL
		select PACKAGE_librt
		select PACKAGE_musl-fts if USE_MUSL
		select PACKAGE_libc
		select PACKAGE_libdnet
		select PACKAGE_libpcap
		help
		 tcpreplay is a tool for replaying network traffic from files saved with
		   tcpdump or other tools which write pcap(3) files.
		 http://tcpreplay.appneta.com/
		 Alexandru Ardelean <ardeleanalex@gmail.com>

	config PACKAGE_tcpreplay-all
		tristate "tcpreplay-all....................... Pcap editing and replaying utilities"
		default y if DEFAULT_tcpreplay-all
		default m if ALL
		select PACKAGE_tcpreplay-edit
		select PACKAGE_tcprewrite
		select PACKAGE_tcpbridge
		select PACKAGE_tcpprep
		select PACKAGE_tcpreplay
		select PACKAGE_tcpcapinfo
		select PACKAGE_libc
		select PACKAGE_tcpliveplay
		help
		 Tcpreplay is a suite of free Open Source utilities for
		   editing and replaying previously captured network traffic.
		   Originally designed to replay malicious traffic patterns to
		   Intrusion Detection/Prevention Systems, it has seen many evolutions
		   including capabilities to replay to web servers.
		 
		   Version 4.0.0 introduces features and performance enhancements
		   to support switches, routers, and IP Flow/NetFlow appliances. 
		 http://tcpreplay.appneta.com/
		 Alexandru Ardelean <ardeleanalex@gmail.com>

	config PACKAGE_tcpreplay-edit
		tristate "tcpreplay-edit............... Replay network traffic stored in pcap files"
		default y if DEFAULT_tcpreplay-edit
		default m if ALL
		select PACKAGE_libpcap
		select PACKAGE_musl-fts if USE_MUSL
		select PACKAGE_libdnet
		select PACKAGE_libc
		select PACKAGE_librt
		help
		 tcpreplay-edit includes all the functionality of both tcpreplay
		   and tcprewrite.
		 http://tcpreplay.appneta.com/
		 Alexandru Ardelean <ardeleanalex@gmail.com>

	config PACKAGE_tcprewrite
		tristate "tcprewrite............................ Rewrite the packets in a pcap file"
		default y if DEFAULT_tcprewrite
		default m if ALL
		select PACKAGE_librt
		select PACKAGE_libdnet
		select PACKAGE_libc
		select PACKAGE_musl-fts if USE_MUSL
		select PACKAGE_libpcap
		help
		 Rewrite/edit the packets in a pcap file
		 http://tcpreplay.appneta.com/
		 Alexandru Ardelean <ardeleanalex@gmail.com>

endmenu
menu "Time Synchronization"
	config PACKAGE_chrony
		tristate "chrony................... A versatile NTP client and server (without NTS)"
		default y if DEFAULT_chrony
		default m if ALL
		select PACKAGE_libcap
		select PACKAGE_libpthread
		select PACKAGE_libc
		depends on m || (PACKAGE_chrony-nts != y)
		help
		 An NTP client and server designed to perform well in a wide range
		 	of conditions. It can synchronize the system clock with NTP servers,
		 	reference clocks, and manual input using wristwatch and keyboard.
		 http://chrony.tuxfamily.org/
		 Miroslav Lichvar <mlichvar0@gmail.com>

	config PACKAGE_chrony-nts
		tristate "chrony-nts.................. A versatile NTP client and server (with NTS)"
		default y if DEFAULT_chrony-nts
		default m if ALL
		select PACKAGE_ca-bundle
		select PACKAGE_libpthread
		select PACKAGE_libgnutls
		select PACKAGE_libcap
		select PACKAGE_libc
		help
		 An NTP client and server designed to perform well in a wide range
		 	of conditions. It can synchronize the system clock with NTP servers,
		 	reference clocks, and manual input using wristwatch and keyboard.
		 http://chrony.tuxfamily.org/
		 Miroslav Lichvar <mlichvar0@gmail.com>

	config PACKAGE_htpdate
		tristate "htpdate.................. an HTP (Hypertext Time Protocol) implementation"
		default y if DEFAULT_htpdate
		default m if ALL
		select PACKAGE_libc
		help
		 The HTTP Time Protocol (HTP) is used to synchronize a computer's time
		 	with web servers as reference time source. Htpdate will synchronize your
		 	computer's time by extracting timestamps from HTTP headers found
		 	in web server responses. Htpdate can be used as a daemon, to keep your
		 	computer synchronized.
		 http://www.vervest.com/htp/
		 Tijs Van Buggenhout <tvbuggen@netzerk.be>, Marcin Jurkowski <marcin1j@gmail.com>

	config PACKAGE_linuxptp
		tristate "linuxptp...................... Linux Precision Time Protocol (PTP) daemon"
		default y if DEFAULT_linuxptp
		default m if ALL
		select PACKAGE_libc
		help
		 The PTP daemon (PTPd) implements version 2 of the Precision Time Protocol (PTP)
		  as defined by the IEEE 1588-2008 standard.
		  PTP was developed to provide very precise time coordination of LAN connected
		  computers.
		 http://linuxptp.sourceforge.net/
		 Wojciech Dubowik <Wojciech.Dubowik@westermo.com>

	config PACKAGE_ntp-keygen
		tristate "ntp-keygen................................................ ISC ntp keygen"
		default y if DEFAULT_ntp-keygen
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libevent2-core
		select PACKAGE_libcap
		select PACKAGE_libopenssl
		select PACKAGE_libpthread
		help
		 The ISC ntp suite is a collection of tools used to synchronize the
		  system clock with remote NTP time servers and run/monitor local NTP
		  servers.
		  .
		  This package contains the ntp-keygen.
		 http://www.ntp.org/
		 Peter Wagner <tripolar@gmx.at>

	config PACKAGE_ntp-utils
		tristate "ntp-utils.............................................. ISC ntp utilities"
		default y if DEFAULT_ntp-utils
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libevent2-pthreads
		select PACKAGE_libcap
		select PACKAGE_libpthread
		select PACKAGE_libopenssl
		help
		 The ISC ntp suite is a collection of tools used to synchronize the
		  system clock with remote NTP time servers and run/monitor local NTP
		  servers.
		  .
		  This package contains ntpdc, ntpq, ntptime and sntp.
		 http://www.ntp.org/
		 Peter Wagner <tripolar@gmx.at>

	config PACKAGE_ntpd
		tristate "ntpd...................................................... ISC ntp server"
		default y if DEFAULT_ntpd
		default m if ALL
		select PACKAGE_ntp-utils
		select PACKAGE_libc
		select PACKAGE_libpthread
		select PACKAGE_libopenssl
		select PACKAGE_libcap
		help
		 The ISC ntp suite is a collection of tools used to synchronize the
		  system clock with remote NTP time servers and run/monitor local NTP
		  servers.
		  .
		  This package contains the ntpd server.
		 http://www.ntp.org/
		 Peter Wagner <tripolar@gmx.at>

	config PACKAGE_ntpdate
		tristate "ntpdate..................................................... ISC ntp date"
		default y if DEFAULT_ntpdate
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libpthread
		select PACKAGE_libopenssl
		select PACKAGE_libcap
		help
		 The ISC ntp suite is a collection of tools used to synchronize the
		  system clock with remote NTP time servers and run/monitor local NTP
		  servers.
		  .
		  This package contains ntpdate.
		 http://www.ntp.org/
		 Peter Wagner <tripolar@gmx.at>

endmenu
menu "VPN"
	config PACKAGE_accel_pptpd
		tristate "accel_pptpd............................................ Accel pptp server"
		default y if DEFAULT_accel_pptpd
		default m if ALL
		select PACKAGE_ppp-mod-pptp
		depends on (PACKAGE_ppp||PACKAGE_ppp-multilink)
		select PACKAGE_libc
		help
		 Accel pptp server
		 https://downloads.sourceforge.net/project/accel-pptp/accel-pptp/
		 

	config PACKAGE_chaosvpn
		tristate "chaosvpn.................................. Config generator for chaos vpn"
		default y if DEFAULT_chaosvpn
		default m if ALL
		select PACKAGE_zlib
		select PACKAGE_libopenssl
		select PACKAGE_kmod-tun
		select PACKAGE_ip-tiny if PACKAGE_ip-full<PACKAGE_chaosvpn
		select PACKAGE_tinc
		select PACKAGE_libc
		help
		 Configure tincd for the chaosvpn network
		 https://wiki.hamburg.ccc.de/index.php/ChaosVPN::DebianHowto
		 Norbert Summer <git@o-g.at>

	config PACKAGE_eoip
		tristate "eoip........................... Mikrotik-compatible userspace EoIP tunnel"
		default y if DEFAULT_eoip
		default m if ALL
		select PACKAGE_liblzo
		select PACKAGE_libc
		select PACKAGE_kmod-tun
		select PACKAGE_libpthread
		help
		 linux-eoip can create ethernet tunnels compatible with Mikrotik EoIP tunnel.
		   At current moment it is easiest way to create stateless tunnel with Mikrotik.
		 https://code.google.com/p/linux-eoip/
		 Bogdan Shatik <bogdikxxx@mail.ru>

	config PACKAGE_fastd
		tristate "fastd................................... Fast and Secure Tunneling Daemon"
		default y if DEFAULT_fastd
		default m if ALL
		select PACKAGE_libuecc
		select PACKAGE_libc
		select PACKAGE_libjson-c if FASTD_WITH_STATUS_SOCKET
		select PACKAGE_libpthread
		select PACKAGE_kmod-tun
		select PACKAGE_libcap if FASTD_WITH_CAPABILITIES
		help
		 Fast and secure tunneling daemon, which is optimized on small code size and few dependencies
		 https://github.com/neocturne/fastd/
		 Matthias Schiffer <mschiffer@universe-factory.net>


	
	  source "qca/feeds/packages/net/fastd/Config.in"

	config PACKAGE_libreswan
		tristate "libreswan......................................... Libreswan IPsec Server"
		default y if DEFAULT_libreswan
		default m if ALL
		select PACKAGE_kmod-crypto-aead
		select PACKAGE_librt
		select PACKAGE_libevent2
		select PACKAGE_nss-utils
		select PACKAGE_libcap-ng
		select PACKAGE_libevent2-pthreads
		select PACKAGE_kmod-ip6-vti if IPV6
		select PACKAGE_libunbound
		depends on IPV6
		select PACKAGE_kmod-crypto-authenc
		select PACKAGE_iptables-mod-ipsec
		select PACKAGE_kmod-ipsec
		select PACKAGE_kmod-ip-vti
		select PACKAGE_kmod-crypto-gcm
		select PACKAGE_kmod-xfrm-interface
		select PACKAGE_kmod-ipsec6 if IPV6
		select PACKAGE_ip-full
		select PACKAGE_nspr
		select PACKAGE_libldns
		select PACKAGE_kmod-crypto-rng
		select PACKAGE_kmod-ipt-ipsec
		select PACKAGE_libc
		select PACKAGE_kmod-ipsec4
		select PACKAGE_kmod-crypto-hash
		depends on m || (PACKAGE_strongswan != y)
		help
		 Libreswan is a free software implementation of the most widely supported and
		  standardized VPN protocol based on ("IPsec") and the Internet Key Exchange
		  ("IKE"). These standards are produced and maintained by the Internet
		  Engineering Task Force ("IETF").
		  Libreswan is a free software implementation of the most widely supported and
		  standardized VPN protocol based on ("IPsec") and the Internet Key Exchange
		  ("IKE"). These standards are produced and maintained by the Internet
		  Engineering Task Force ("IETF").
		 https://libreswan.org/
		 Lucian Cristian <lucian.cristian@gmail.com>

	config PACKAGE_netbird
		tristate "netbird"
		default y if DEFAULT_netbird
		default m if ALL
		depends on (aarch64||arm||i386||i686||mips||mips64||mips64el||mipsel||powerpc64||riscv64||x86_64)
		select PACKAGE_libc
		help
		 NetBird is an open-source VPN management platform built on top of WireGuard® making it easy to create
		   secure private networks for your organization or home.
		 
		   It requires zero configuration effort leaving behind the hassle of opening ports, complex firewall rules, VPN
		   gateways, and so forth.
		 https://netbird.io
		 Oskari Rauta <oskari.rauta@gmail.com>

	config PACKAGE_ocserv
		tristate "ocserv............................................ OpenConnect VPN server"
		default y if DEFAULT_ocserv
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libhttp-parser if OCSERV_HTTP_PARSER
		select PACKAGE_libncurses
		select PACKAGE_libseccomp if OCSERV_SECCOMP
		select PACKAGE_libprotobuf-c if OCSERV_PROTOBUF
		select PACKAGE_liboath if OCSERV_LIBOATH
		select PACKAGE_libradcli if OCSERV_RADIUS
		select PACKAGE_libpam if OCSERV_PAM
		select PACKAGE_certtool
		select PACKAGE_libgnutls
		select PACKAGE_kmod-tun
		select PACKAGE_libreadline
		select PACKAGE_libev
		help
		 OpenConnect server (ocserv) is an SSL VPN server. Its purpose is to be
		  a secure, small, fast and configurable VPN server. It implements the
		  OpenConnect SSL VPN protocol, and has also (currently experimental)
		  compatibility with clients using the AnyConnect SSL VPN protocol. The
		  OpenConnect VPN protocol uses the standard IETF security protocols such
		  as TLS 1.2, and Datagram TLS to provide the secure VPN service.
		 http://www.infradead.org/ocserv/
		 Nikos Mavrogiannopoulos <n.mavrogiannopoulos@gmail.com>


	
		source "qca/feeds/packages/net/ocserv/Config.in"

	config PACKAGE_openconnect
		tristate "openconnect"
		default y if DEFAULT_openconnect
		default m if ALL
		select PACKAGE_libtasn1 if OPENCONNECT_GNUTLS
		select PACKAGE_libopenssl if OPENCONNECT_OPENSSL
		select PACKAGE_vpnc-scripts
		select PACKAGE_libxml2
		select PACKAGE_kmod-tun
		select PACKAGE_resolveip
		select PACKAGE_libiconv-full if BUILD_NLS
		select PACKAGE_p11-kit if OPENCONNECT_OPENSSL
		select PACKAGE_libp11 if OPENCONNECT_OPENSSL
		select PACKAGE_libstoken if OPENCONNECT_STOKEN
		select PACKAGE_libintl-full if BUILD_NLS
		select PACKAGE_libc
		select PACKAGE_libgnutls if OPENCONNECT_GNUTLS
		help
		 A VPN client compatible with several SSL VPN implementations (ocserv, Cisco AnyConnect, Juniper, Palo Alto)
		 
		 	OpenConnect is an SSL VPN client initially created to support Cisco's
		 	AnyConnect SSL VPN. It has since been extended to support the Pulse Connect
		 	Secure VPN (formerly known as Juniper Network Connect or Junos Pulse) and
		 	the Palo Alto Networks GlobalProtect SSL VPN.
		 
		 	A corresponding OpenConnect VPN server implementation can be found in the
		 	ocserv package.
		 https://www.infradead.org/openconnect/
		 Nikos Mavrogiannopoulos <n.mavrogiannopoulos@gmail.com>


	
		source "qca/feeds/packages/net/openconnect/Config.in"

	config PACKAGE_openfortivpn
		tristate "openfortivpn..................................... Fortinet SSL VPN client"
		default y if DEFAULT_openfortivpn
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_ppp
		select PACKAGE_libopenssl
		help
		 An open implementation of Fortinet's proprietary PPP+SSL VPN solution
		   It spawns a pppd process and operates the communication between the gateway and this process.
		   It is compatible with Fortinet VPNs.
		 https://github.com/adrienverge/openfortivpn
		 Lucian Cristian <lucian.cristian@gmail.com>

	config PACKAGE_openswan
		tristate "openswan............................................... Openswan (daemon)"
		default y if DEFAULT_openswan
		default m if ALL
