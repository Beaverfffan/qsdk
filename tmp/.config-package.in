	menuconfig PACKAGE_kmod-qca-nss-ecm-noload
		tristate "kmod-qca-nss-ecm-noload"
		default y if DEFAULT_kmod-qca-nss-ecm-noload
		default m if ALL||ALL_NONSHARED||ALL_KMODS
		select PACKAGE_kmod-qca-nss-drv if TARGET_ipq_ipq50xx_64
		select PACKAGE_kmod-pppoe
		depends on !(TARGET_ipq95xx && TARGET_ipq95xx) || TARGET_ipq95xx||TARGET_ipq53xx
		select PACKAGE_kmod-qca-nss-drv if TARGET_ipq806x
		depends on !(PACKAGE_kmod-qca-nss-ppe-mapt) || IPV6
		depends on !(TARGET_ipq53xx && TARGET_ipq95xx) || TARGET_ipq95xx||TARGET_ipq53xx
		depends on !(TARGET_ipq_ipq60xx_64 && PACKAGE_kmod-qca-nss-gmac) || TARGET_ipq806x||TARGET_ipq_ipq806x
		depends on !(TARGET_ipq_ipq50xx_64 && PACKAGE_kmod-qca-nss-dp) || (TARGET_ipq807x)
		select PACKAGE_kmod-qca-nss-drv if TARGET_ipq_ipq806x
		depends on !(TARGET_ipq50xx && PACKAGE_kmod-qca-nss-gmac) || TARGET_ipq806x||TARGET_ipq_ipq806x
		depends on !(TARGET_ipq807x) || TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx
		depends on !(TARGET_ipq95xx && TARGET_ipq53xx) || (TARGET_ipq807x)
		depends on !(TARGET_ipq807x && PACKAGE_kmod-qca-nss-dp) || (TARGET_ipq807x)
		select PACKAGE_kmod-qca-nss-drv if TARGET_ipq50xx
		depends on !(TARGET_ipq95xx && TARGET_ipq95xx) || TARGET_ipq807x
		depends on !(TARGET_ipq806x && PACKAGE_kmod-qca-nss-dp) || TARGET_ipq807x
		select PACKAGE_kmod-qca-nss-ppe if TARGET_ipq53xx
		depends on !(PACKAGE_kmod-qca-ovsmgr) || TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq807x_64||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq60xx_64||TARGET_ipq_ipq806x||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx||TARGET_ipq95xx||TARGET_ipq95xx_32||TARGET_ipq53xx
		select PACKAGE_kmod-vxlan
		depends on !(TARGET_ipq_ipq806x) || TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx
		depends on !(TARGET_ipq_ipq50xx_64) || TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx
		depends on !(TARGET_ipq53xx && TARGET_ipq95xx) || TARGET_ipq807x
		select PACKAGE_kmod-qca-nss-ppe if TARGET_ipq95xx
		depends on !(TARGET_ipq95xx && TARGET_ipq95xx) || (TARGET_ipq807x)
		select PACKAGE_iptables-mod-extra
		depends on !(TARGET_ipq_ipq807x_64 && PACKAGE_kmod-qca-nss-gmac) || TARGET_ipq806x||TARGET_ipq_ipq806x
		depends on !(TARGET_ipq_ipq807x && PACKAGE_kmod-qca-nss-dp) || (TARGET_ipq807x)
		depends on !(TARGET_ipq50xx && PACKAGE_kmod-qca-nss-dp) || (TARGET_ipq807x)
		select PACKAGE_kmod-qca-nss-drv if TARGET_ipq_ipq60xx
		depends on !(PACKAGE_kmod-qca-ovsmgr && PACKAGE_kmod-openvswitch-intree<PACKAGE_kmod-qca-nss-ecm-noload && IPV6) || IPV6
		select PACKAGE_kmod-qca-nss-drv if TARGET_ipq_ipq807x
		depends on !(TARGET_ipq95xx) || IPV6
		depends on !(TARGET_ipq60xx && PACKAGE_kmod-qca-nss-gmac) || TARGET_ipq806x||TARGET_ipq_ipq806x
		depends on !(TARGET_ipq53xx && TARGET_ipq53xx) || (TARGET_ipq807x)
		select PACKAGE_kmod-qca-nss-drv if TARGET_ipq60xx
		depends on !(TARGET_ipq_ipq50xx && PACKAGE_kmod-qca-nss-gmac) || TARGET_ipq806x||TARGET_ipq_ipq806x
		depends on !(TARGET_ipq60xx) || TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx
		depends on !(TARGET_ipq_ipq60xx && PACKAGE_kmod-qca-nss-dp) || (TARGET_ipq807x)
		select PACKAGE_kmod-pptp
		select PACKAGE_kmod-qca-nss-sfe if TARGET_ipq53xx
		select PACKAGE_kmod-qca-nss-drv if TARGET_ipq_ipq60xx_64
		depends on !(TARGET_ipq_ipq50xx_64 && PACKAGE_kmod-qca-nss-dp) || TARGET_ipq807x
		depends on !(TARGET_ipq95xx && TARGET_ipq53xx) || TARGET_ipq95xx||TARGET_ipq53xx
		select PACKAGE_kmod-qca-nss-drv if TARGET_ipq807x
		select PACKAGE_kmod-bonding
		depends on !(TARGET_ipq_ipq50xx_64 && PACKAGE_kmod-qca-nss-gmac) || TARGET_ipq806x||TARGET_ipq_ipq806x
		select PACKAGE_kmod-qca-nss-sfe if TARGET_ipq95xx
		depends on !(TARGET_ipq53xx) || IPV6
		depends on !(TARGET_ipq60xx && PACKAGE_kmod-qca-nss-dp) || (TARGET_ipq807x)
