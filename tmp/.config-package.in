		 http://www.anytun.org/
		 Christian Pointner <equinox@spreadspace.org>

	config PACKAGE_uanytun-nocrypt
		tristate "uanytun-nocrypt................ micro anycast tunneling daemon (no crypt)"
		default y if DEFAULT_uanytun-nocrypt
		default m if ALL
		select PACKAGE_kmod-tun
		select PACKAGE_libc
		help
		 uAnytun is a tiny implementation of SATP the secure anycast tunneling protocol.
