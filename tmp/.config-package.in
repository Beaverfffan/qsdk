	config PACKAGE_sane-daemon
		tristate "sane-daemon..................... Scanner Access Now Easy (network daemon)"
		default y if DEFAULT_sane-daemon
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libsane
		help
		 SANE (Scanner Access Now Easy) is a universal scanner interface.
		 This package contains the SANE daemon.
		 http://www.sane-project.org/
		 Luiz Angelo Daros de Luca <luizluca@gmail.com>

	config PACKAGE_sane-frontends
		tristate "sane-frontends....................... Scanner Access Now Easy (frontends)"
		default y if DEFAULT_sane-frontends
		default m if ALL
		select PACKAGE_libjpeg-turbo
		select PACKAGE_libpng
		select PACKAGE_libc
		select PACKAGE_libsane
		help
		 SANE (Scanner Access Now Easy) is a universal scanner interface.
		 This package contains the SANE frontends.
		 http://www.sane-project.org/
		 Luiz Angelo Daros de Luca <luizluca@gmail.com>

	config PACKAGE_secilc
		tristate "secilc............... SELinux Common Intermediate Language (CIL) Compiler"
		default y if DEFAULT_secilc
		default m if ALL
		select PACKAGE_libsepol
		select PACKAGE_libc
		help
		 The SELinux CIL Compiler is a compiler that converts the CIL language as
		 	described on the CIL design wiki into a kernel binary policy file.
		 	Please see the CIL Design Wiki at:
		 	http://github.com/SELinuxProject/cil/wiki/
		 	for more information about the goals and features on the CIL language.
		 http://selinuxproject.org/page/Main_Page
		 Dominick Grift <dominick.grift@defensec.nl>

	config PACKAGE_sed
		tristate "sed............................. sed stream editor utility - full version"
		default y if DEFAULT_sed
		default m if ALL
		select PACKAGE_libc
		help
		 sed (stream editor) is a non-interactive command-line text editor. sed is commonly 
		 used to filter text, i.e., it takes text input, performs some operation (or set of 
		 operations) on it, and outputs the modified text. sed is typically used for 
		 extracting part of a file using pattern matching or substituting multiple 
		 occurrences of a string within a file.
		 https://www.gnu.org/software/sed/
		 Russell Senior <russell@personaltelco.net>

	config PACKAGE_sedutil
		tristate "sedutil........... The Drive Trust Alliance Self Encrypting Drive Utility"
		default y if DEFAULT_sedutil
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libstdcpp
		help
		 This program and it's accompanying Pre-Boot Authorization image allow you to
		 enable the locking in SED's that comply with the TCG OPAL 2.00 standard on bios
		 machines.
		 https://github.com/Drive-Trust-Alliance/sedutil
		 Javier Marcet <javier@marcet.info>

	config PACKAGE_selinux-audit2allow
		tristate "selinux-audit2allow............... SELinux management utility audit2allow"
		default y if DEFAULT_selinux-audit2allow
		default m if ALL
		select PACKAGE_python3-light
		select PACKAGE_libc
		select PACKAGE_python3-selinux
		select PACKAGE_python3-sepolgen
		help
		 A set of SELinux tools written in Python that help with managing a
		 system with SELinux enabled.
		 
		 This package contains the audit2allow and audit2why tools.
		 http://selinuxproject.org/page/Main_Page
		 Thomas Petazzoni <thomas.petazzoni@bootlin.com>

	config PACKAGE_selinux-chcat
		tristate "selinux-chcat........................... SELinux management utility chcat"
		default y if DEFAULT_selinux-chcat
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_python3-light
		select PACKAGE_selinux-semanage
		select PACKAGE_python3-seobject
		select PACKAGE_python3-selinux
		help
		 A set of SELinux tools written in Python that help with managing a
		 system with SELinux enabled.
		 
		 This package contains the chcat tool.
		 http://selinuxproject.org/page/Main_Page
		 Thomas Petazzoni <thomas.petazzoni@bootlin.com>

	config PACKAGE_selinux-python
		tristate "selinux-python................... SELinux management utility meta-package"
		default y if DEFAULT_selinux-python
		default m if ALL
		select PACKAGE_selinux-chcat
		select PACKAGE_selinux-sepolicy
		select PACKAGE_selinux-audit2allow
		select PACKAGE_selinux-sepolgen-ifgen
		select PACKAGE_libc
		select PACKAGE_selinux-semanage
		help
		 A set of SELinux tools written in Python that help with managing a
		 system with SELinux enabled.
		 
		 This is a meta-package that installs all of the SELinux management
		 utilities.
		 http://selinuxproject.org/page/Main_Page
		 Thomas Petazzoni <thomas.petazzoni@bootlin.com>

	config PACKAGE_selinux-semanage
		tristate "selinux-semanage..................... SELinux management utility semanage"
		default y if DEFAULT_selinux-semanage
