		select PACKAGE_python3-logging
		select PACKAGE_libc
		help
		 Tunneldigger is a simple VPN tunneling solution based on the Linux kernel
		 support for L2TPv3 tunnels over UDP. This package contains the broker.
		 https://github.com/wlanslovenija/tunneldigger
		 Nick Hainke <vincent@systemli.org>

	config PACKAGE_tunneldigger-broker-src
		tristate "tunneldigger-broker-src"
		default y if DEFAULT_tunneldigger-broker-src
