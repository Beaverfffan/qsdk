		 Programming library for writing an XML-RPC server or client in C or C++.
		     XML-RPC is a standard network protocol to allow a client program to make
		     a simple remote procedure call (RPC) type request of a server. Uses internal expat variant (stripped down)
		 http://xmlrpc-c.sourceforge.net/
		 Ted Hess <thess@kitschensync.net>

	config PACKAGE_xmlrpc-c-server
		tristate "xmlrpc-c-server................................. XML-RPC library - server"
		default y if DEFAULT_xmlrpc-c-server
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_xmlrpc-c
		help
		 XML-RPC library - server
		 http://xmlrpc-c.sourceforge.net/
		 Ted Hess <thess@kitschensync.net>

	config PACKAGE_yajl
		tristate "yajl............................................ Yet Another JSON Library"
		default y if DEFAULT_yajl
		default m if ALL
		select PACKAGE_libc
		help
		 Yet Another JSON Library. YAJL is a small event-driven (SAX-style)
		 JSON parser written in ANSI C, and a small validating JSON generator.
		 YAJL is released under the ISC license.
		 
		   YAJL was created by Lloyd Hilaiel.
		 https://lloyd.github.io/yajl
		 Charles Southerland <charlie@stuphlabs.com>

	config PACKAGE_yubico-pam
		tristate "yubico-pam......................................... The Yubico PAM module"
		default y if DEFAULT_yubico-pam
		default m if ALL
		select PACKAGE_curl
		select PACKAGE_libpam
		select PACKAGE_libyubikey
		select PACKAGE_ykclient
		select PACKAGE_libc
		select PACKAGE_ykpers
		help
		 The Yubico PAM module provides an easy way to integrate the YubiKey
		 	into your existing user authentication infrastructure.
		 https://developers.yubico.com/yubico-pam/
		 Stuart B. Wilkins <stuwilkins@mac.com>

	config PACKAGE_zlib
		tristate "zlib................. Library implementing the deflate compression method"
		default y if DEFAULT_zlib
		default m if ALL
		select PACKAGE_libc
		help
		 zlib is a lossless data-compression library.
		  This package includes the shared library.
		 http://www.zlib.net/
		 


	
		source "package/libs/zlib/Config.in"

	config PACKAGE_zlog
		tristate "zlog.............................................. Pure C logging library"
		default y if DEFAULT_zlog
		default m if ALL
		select PACKAGE_libc
		help
		 zlog is a reliable, high-performance, thread safe, flexible, clear-model, pure C logging library.
		 http://hardysimpson.github.io/zlog/
		 Marko Ratkaj <markoratkaj@gmail.com>

endmenu

menu "LuCI"

menu "1. Collections"
	config PACKAGE_luci
		tristate "luci................... LuCI interface with Uhttpd as Webserver (default)"
		default y if DEFAULT_luci
		default m if ALL
		select PACKAGE_luci-light
		depends on !(PACKAGE_firewall4<PACKAGE_luci && IPV6) || IPV6
		select PACKAGE_libc
		select PACKAGE_luci-app-opkg
		help
		 Standard OpenWrt set including package management and attended sysupgrades support
		 https://github.com/openwrt/luci
		 OpenWrt LuCI community

	config PACKAGE_luci-lib-docker
		tristate "luci-lib-docker.................................. LuCI library for docker"
		default y if DEFAULT_luci-lib-docker
		default m if ALL
		select PACKAGE_luci-lib-jsonc
		select PACKAGE_luci-lua-runtime
		select PACKAGE_libc
		depends on (aarch64||arm||x86_64)
		help
		 Docker Engine API for LuCI
		 https://github.com/openwrt/luci
		 OpenWrt LuCI community

	config PACKAGE_luci-light
		tristate "luci-light............... LuCI interface with Uhttpd as Webserver (light)"
		default y if DEFAULT_luci-light
		default m if ALL
		select PACKAGE_rpcd-mod-rrdns
		depends on !(PACKAGE_firewall4<PACKAGE_luci-light && IPV6) || IPV6
		select PACKAGE_luci-mod-admin-full
		select PACKAGE_uhttpd
		select PACKAGE_luci-proto-ipv6 if IPV6
		select PACKAGE_luci-theme-bootstrap
		select PACKAGE_luci-app-firewall
		select PACKAGE_uhttpd-mod-ubus
		select PACKAGE_luci-proto-ppp
		select PACKAGE_libc
		help
		 Light OpenWrt set including admin support and the default Bootstrap theme
		 https://github.com/openwrt/luci
		 OpenWrt LuCI community

	config PACKAGE_luci-nginx
		tristate "luci-nginx........................ LuCI interface with Nginx as Webserver"
		default y if DEFAULT_luci-nginx
		default m if ALL
		select PACKAGE_rpcd-mod-rrdns
		select PACKAGE_nginx-mod-luci
		select PACKAGE_luci-theme-bootstrap
		select PACKAGE_libc
		select PACKAGE_luci-proto-ppp
		select PACKAGE_luci-app-firewall
		select PACKAGE_luci-app-opkg
		select PACKAGE_luci-mod-admin-full
		select PACKAGE_luci-proto-ipv6 if IPV6
		select PACKAGE_nginx
		depends on !(PACKAGE_firewall4<PACKAGE_luci-nginx && IPV6) || IPV6
		help
		 Standard OpenWrt set including full admin with ppp support and the default Bootstrap theme
		 https://github.com/openwrt/luci
		 OpenWrt LuCI community

	config PACKAGE_luci-ssl
		tristate "luci-ssl................ LuCI with HTTPS support (mbedtls as SSL backend)"
		default y if DEFAULT_luci-ssl
		default m if ALL
		select PACKAGE_luci-light
		depends on !(PACKAGE_firewall4<PACKAGE_luci-ssl && IPV6) || IPV6
		select PACKAGE_libc
		select PACKAGE_libustream-mbedtls
		select PACKAGE_px5g-mbedtls
		help
		 LuCI with HTTPS support (mbedtls as SSL backend)
		 https://github.com/openwrt/luci
		 OpenWrt LuCI community

	config PACKAGE_luci-ssl-nginx
		tristate "luci-ssl-nginx. LuCI with HTTPS support on Nginx (OpenSSL as SSL backend)"
		default y if DEFAULT_luci-ssl-nginx
		default m if ALL
		select PACKAGE_luci-app-opkg
		select PACKAGE_openssl-util
		select PACKAGE_nginx-mod-luci-ssl
		select PACKAGE_nginx-ssl if PACKAGE_nginx-full<PACKAGE_luci-ssl-nginx
		select PACKAGE_luci-proto-ipv6 if IPV6
		select PACKAGE_luci-mod-admin-full
		select PACKAGE_rpcd-mod-rrdns
		depends on !(PACKAGE_firewall4<PACKAGE_luci-ssl-nginx && IPV6) || IPV6
		select PACKAGE_libc
		select PACKAGE_luci-proto-ppp
		select PACKAGE_luci-app-firewall
		select PACKAGE_luci-theme-bootstrap
		help
		 LuCI with OpenSSL as the SSL backend (libustream-openssl). OpenSSL cmd tools (openssl-util) are used by nginx for SSL key generation.
		 https://github.com/openwrt/luci
		 OpenWrt LuCI community

	config PACKAGE_luci-ssl-openssl
		tristate "luci-ssl-openssl........ LuCI with HTTPS support (OpenSSL as SSL backend)"
		default y if DEFAULT_luci-ssl-openssl
		default m if ALL
		select PACKAGE_openssl-util
		depends on !(PACKAGE_firewall4<PACKAGE_luci-ssl-openssl && IPV6) || IPV6
		select PACKAGE_libc
		select PACKAGE_libustream-openssl
		select PACKAGE_luci-light
		help
		 LuCI with OpenSSL as the SSL backend (libustream-openssl). OpenSSL cmd tools (openssl-util) are used by uhttpd for SSL key generation instead of the default px5g. (If px5g is installed, uhttpd will prefer that.)
		 https://github.com/openwrt/luci
		 OpenWrt LuCI community

endmenu
