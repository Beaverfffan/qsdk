	menuconfig PACKAGE_olsrd
		tristate "olsrd......................... OLSR (Optimized Link State Routing) daemon"
		default y if DEFAULT_olsrd
		default m if ALL
		select PACKAGE_libpthread
		depends on !(IPV6 && PACKAGE_ip6tables-zz-legacy<PACKAGE_olsrd) || IPV6
		select PACKAGE_ip6tables-nft if IPV6 && PACKAGE_ip6tables-zz-legacy<PACKAGE_olsrd
		depends on !(IPV6 && PACKAGE_ip6tables-zz-legacy<PACKAGE_olsrd && IPV6) || IPV6
		depends on !(PACKAGE_iptables-zz-legacy<PACKAGE_olsrd && IPV6) || IPV6
		select PACKAGE_iptables-nft if PACKAGE_iptables-zz-legacy<PACKAGE_olsrd
		select PACKAGE_libc
		select PACKAGE_libubus
		help
		 OLSR (Optimized Link State Routing) daemon
		 http://www.olsr.org/
		 Saverio Proto <zioproto@gmail.com>

