		select PACKAGE_libc
		select PACKAGE_libubus
		select PACKAGE_libubox
		help
		 PWM/RGB LED ubus frontend
		 John Crispin <john@phrozen.org>

	config PACKAGE_unix2dos
		tristate "unix2dos.......................... Text file format converters (unix2dos)"
