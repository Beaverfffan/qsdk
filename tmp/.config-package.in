	config PACKAGE_smcroute
		tristate "smcroute................................. Static Multicast Routing Daemon"
		default y if DEFAULT_smcroute
		default m if ALL
		select PACKAGE_libc
		help
		 SMCRoute is a command line tool to manipulate the multicast routes of the Linux kernel.
		 http://troglobit.com/smcroute.html
		 Moritz Warning <moritzwarning@web.de>

	config PACKAGE_ss
		tristate "ss............................................. Socket statistics utility"
		default y if DEFAULT_ss
		default m if ALL
		select PACKAGE_libnl-tiny
		select PACKAGE_libc
		select PACKAGE_libmnl if (PACKAGE_devlink||PACKAGE_rdma)
		select PACKAGE_kmod-netlink-diag
		help
		 Socket statistics utility
		 http://www.linuxfoundation.org/collaborate/workgroups/networking/iproute2
		 Russell Senior <russell@personaltelco.net>

	config PACKAGE_sslh
		tristate "sslh................................................. SSL/SSH multiplexer"
		default y if DEFAULT_sslh
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libconfig
		select PACKAGE_libpcre2
		select PACKAGE_libcap
		help
		 SSL/SSH multiplexer
		 https://rutschle.net/tech/sslh/README.html
		 Jonathan McCrohan <jmccrohan@gmail.com>


	
	    config SSLH_SELECT
	        bool "Use sslh-select"
	        depends on PACKAGE_sslh
	        help
	            Use sslh-select instead of sslh-fork.
	        default n

	config PACKAGE_tc-bpf
		tristate "tc-bpf..................................... Traffic control utility (bpf)"
		default y if DEFAULT_tc-bpf
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libbpf
		select PACKAGE_libmnl if (PACKAGE_devlink||PACKAGE_rdma)
		select PACKAGE_kmod-sched-core
		help
		 Traffic control utility (bpf)
		 http://www.linuxfoundation.org/collaborate/workgroups/networking/iproute2
		 Russell Senior <russell@personaltelco.net>

	config PACKAGE_tc-full
		tristate "tc-full................................... Traffic control utility (full)"
		default y if DEFAULT_tc-full
		default m if ALL
		select PACKAGE_libxtables
		select PACKAGE_tc-mod-iptables
		select PACKAGE_libc
		select PACKAGE_libbpf
		select PACKAGE_kmod-sched-core
		select PACKAGE_libmnl if (PACKAGE_devlink||PACKAGE_rdma)
		help
		 Traffic control utility (full)
		 http://www.linuxfoundation.org/collaborate/workgroups/networking/iproute2
		 Russell Senior <russell@personaltelco.net>

	config PACKAGE_tc-mod-iptables
		tristate "tc-mod-iptables................. Traffic control module - iptables action"
		default y if DEFAULT_tc-mod-iptables
		default m if ALL
		select PACKAGE_libxtables
		select PACKAGE_libc
		select PACKAGE_libbpf
		help
		 Traffic control module - iptables action
		 http://www.linuxfoundation.org/collaborate/workgroups/networking/iproute2
		 Russell Senior <russell@personaltelco.net>

	config PACKAGE_tc-tiny
		tristate "tc-tiny................................ Traffic control utility (minimal)"
		default y if DEFAULT_tc-tiny
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libmnl if (PACKAGE_devlink||PACKAGE_rdma)
		select PACKAGE_kmod-sched-core
		help
		 Traffic control utility (minimal)
		 http://www.linuxfoundation.org/collaborate/workgroups/networking/iproute2
		 Russell Senior <russell@personaltelco.net>

	config PACKAGE_tcpproxy
		tristate "tcpproxy.................................. IPv4/IPv6 tcp connection proxy"
		default y if DEFAULT_tcpproxy
		default m if ALL
		select PACKAGE_libc
		help
		 tcpproxy is a simple tcp connection proxy which combines the features of rinetd and 6tunnel.
		  tcpproxy supports IPv4 and IPv6 and also supports connections from IPv6 to IPv4 endpoints and vice versa.
		 http://www.spreadspace.org/tcpproxy/
		 Christian Pointner <equinox@spreadspace.org>

	config PACKAGE_udp-broadcast-relay-redux
		tristate "udp-broadcast-relay-redux"
		default y if DEFAULT_udp-broadcast-relay-redux
		default m if ALL
		select PACKAGE_libc
		help
		 This program listens for packets on a specified UDP broadcast port.
		 	When a packet is received, it sends that packet to all specified interfaces but
		 	the one it came from as though it originated from the original sender.
		 	The primary purpose of this is to allow games on machines on separated
		 	local networks (Ethernet, WLAN) that use udp broadcasts to find each other to do so.
		 	It also works on ppp links, so you can log in from windows boxes (e.g. using pptp)
		 	and play LAN-based games together. Currently, you have to care about upcoming or
		 	downgoing interfaces yourself.
		 https://github.com/udp-redux/udp-broadcast-relay-redux
		 

	config PACKAGE_vis
		tristate "vis........................ visualization server for B.A.T.M.A.N. layer 3"
		default y if DEFAULT_vis
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libpthread
		help
		 visualization server for B.A.T.M.A.N. layer 3
		 https://www.open-mesh.org/
		 Corinna "Elektra" Aichele <onelektra@gmx.net>

	config PACKAGE_yggdrasil
		tristate "yggdrasil.......... Yggdrasil supports end-to-end encrypted IPv6 networks"
		default y if DEFAULT_yggdrasil
		default m if ALL
		depends on IPV6
		select PACKAGE_kmod-tun
		depends on (aarch64||arm||i386||i686||mips||mips64||mips64el||mipsel||powerpc64||riscv64||x86_64)
		select PACKAGE_libc
		help
		 Yggdrasil builds end-to-end encrypted networks with IPv6.
		  Beyond the similarities with cjdns is a different routing
		  algorithm. This globally-agreed spanning tree uses greedy
		  routing in a metric space. Back-pressure routing techniques
		  allow advanced link aggregation bonding on per-stream basis.
		  In turn, a single stream will span across multiple network
		  interfaces simultaneously with much greater throughput.
		 https://yggdrasil-network.github.io/
		 William Fleurant <meshnet@protonmail.com>

endmenu
