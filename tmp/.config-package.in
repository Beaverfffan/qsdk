	config PACKAGE_openappid
		tristate "openappid............. Detection language and processing module for Snort"
		default y if DEFAULT_openappid
		default m if ALL
		depends on !((TARGET_x86||TARGET_x86_64)) || !mipsel
		depends on !((TARGET_x86||TARGET_x86_64)) || TARGET_x86_64
		depends on !((TARGET_x86||TARGET_x86_64)) || !mips
		depends on (i386||x86_64||arm||armeb||aarch64||powerpc||mips||mipsel||mips64)
		depends on !((TARGET_x86||TARGET_x86_64)) || ((mips||mipsel||mips64||powerpc64||x86_64||arm||aarch64)||(USE_GLIBC&&(powerpc||i386)))
