	config PACKAGE_podman
		tristate "podman............................................................ Podman"
		default y if DEFAULT_podman
		default m if ALL
		select PACKAGE_libseccomp
		depends on (aarch64||arm||i386||i686||mips||mipsel||mips64||mips64el||mipsel||powerpc64||riscv64||x86_64)
		select PACKAGE_kmod-veth
		select PACKAGE_libc
		depends on !arc
		select PACKAGE_aardvark-dns
		select PACKAGE_nsenter
		select PACKAGE_libgpgme
		select PACKAGE_libselinux if PODMAN_SELINUX_SUPPORT
		depends on (aarch64||arm||i386||i686||mips||mips64||mips64el||mipsel||powerpc64||riscv64||x86_64)
		select PACKAGE_catatonit
		select PACKAGE_conmon
		select PACKAGE_slirp4netns
		select PACKAGE_netavark
		select PACKAGE_crun
		select PACKAGE_zoneinfo-simple
		help
		 Podman: A tool for managing OCI containers and pods
		 https://podman.io
		 Oskari Rauta <oskari.rauta@gmail.com>


	
	  menu "Configuration"
	
	    config PODMAN_SELINUX_SUPPORT
	    bool "Enable SELinux support"
	    default n
	
	  endmenu

