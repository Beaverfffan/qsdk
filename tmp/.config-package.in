	menuconfig PACKAGE_frr
		tristate "frr........................... The FRRouting (FRR) Software Routing Suite"
		default y if DEFAULT_frr
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_librt
		help
		 FRRouting is free software that implements and manages various IPv4 and IPv6
		   routing protocols.
		 
		   Currently FRRouting supports BGP4, BGP4+, OSPFv2, OSPFv3, RIPv1, RIPv2, RIPng,
		   IS-IS, PIM-SM/MSDP, LDP, VRRP and Babel as well as very early support for EIGRP and
		   NHRP.
		 https://www.frrouting.org/
		 Lucian Cristian <lucian.cristian@gmail.com>

	config PACKAGE_frr-libfrr
		tristate "frr-libfrr................................................. zebra library"
		default y if DEFAULT_frr-libfrr
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libyang
		select PACKAGE_libcap
		select PACKAGE_libnetsnmp if FRR_SNMP
		select PACKAGE_libopenssl if FRR_OPENSSL
		select PACKAGE_libjson-c
		select PACKAGE_libatomic
		depends on PACKAGE_frr
		select PACKAGE_librt
		depends on m || (PACKAGE_quagga-libzebra != y)
		help
		 zebra library
		 https://www.frrouting.org/
		 Lucian Cristian <lucian.cristian@gmail.com>


	
