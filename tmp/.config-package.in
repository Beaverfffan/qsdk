	config PACKAGE_python3-numpy
		tristate "python3-numpy"
		default y if DEFAULT_python3-numpy
		default m if ALL
		select PACKAGE_libgfortran if INSTALL_GFORTRAN
		select PACKAGE_python3
		depends on !SOFT_FLOAT
		select PACKAGE_openblas if NUMPY_OPENBLAS_SUPPORT
		depends on !(NUMPY_OPENBLAS_SUPPORT) || !powerpc
		depends on !(NUMPY_OPENBLAS_SUPPORT) || !arc
		select PACKAGE_libc
		help
		 NumPy is the fundamental package for array computing with Python.
		 
		 By default, this package is built without some modules.
		 For some modules to be available, the INSTALL_GFORTRAN symbol needs
		 to be enabled in the OpenWrt core/toolchain.
		 https://www.numpy.org/
		 Alexandru Ardelean <ardeleanalex@gmail.com>


	
	menu "Configuration"
	depends on !powerpc
	depends on !arc
	
	config NUMPY_OPENBLAS_SUPPORT
	        bool "Enable OpenBLAS support"
	        default n
	
	endmenu

