menu "Open vSwitch"
	config PACKAGE_openvswitch
		tristate "openvswitch................................................. Open vSwitch"
		default y if DEFAULT_openvswitch
		default m if ALL
		select PACKAGE_kmod-openvswitch if PACKAGE_kmod-openvswitch-intree<PACKAGE_openvswitch
		depends on !(PACKAGE_kmod-openvswitch-intree<PACKAGE_openvswitch && IPV6) || IPV6
		select PACKAGE_uuidgen
		select PACKAGE_coreutils
		depends on !(!(arc||arceb)) || ((mips||mipsel||mips64||powerpc64||x86_64||arm||aarch64)||(USE_GLIBC&&(powerpc||i386)))
		select PACKAGE_libc
		select PACKAGE_openvswitch-common
		select PACKAGE_openvswitch-ovsdb
		select PACKAGE_coreutils-sleep
		select PACKAGE_libatomic
		select PACKAGE_openvswitch-vswitchd
		help
		 Open vSwitch
		 https://www.openvswitch.org
		 Yousong Zhou <yszhou4tech@gmail.com>


	
	source "qca/feeds/packages/net/openvswitch/Config.in"

	config PACKAGE_openvswitch-common
		tristate 
		default y if DEFAULT_openvswitch-common
		select PACKAGE_libc
		select PACKAGE_openvswitch-libofproto
		depends on !(!(arc||arceb)) || ((mips||mipsel||mips64||powerpc64||x86_64||arm||aarch64)||(USE_GLIBC&&(powerpc||i386)))
		select PACKAGE_openvswitch-libopenvswitch
		select PACKAGE_openvswitch-libovsdb
		select PACKAGE_libatomic
		help
		 Open vSwitch (common files)
		 https://www.openvswitch.org
		 Yousong Zhou <yszhou4tech@gmail.com>

	config PACKAGE_openvswitch-libofproto
