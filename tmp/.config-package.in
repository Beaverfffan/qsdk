		select PACKAGE_libc
		select PACKAGE_quagga-libospf
		help
		 OSPFv2 routing engine
		 https://www.quagga.net
		 Vasilis Tsiligiannis <acinonyx@openwrt.gr>

	config PACKAGE_quagga-ripd
		tristate "quagga-ripd........................................... RIP routing engine"
		default y if DEFAULT_quagga-ripd
