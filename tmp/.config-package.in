	config PACKAGE_bluelog
		tristate "bluelog..................................... Bluetooth scanner and logger"
		default y if DEFAULT_bluelog
		default m if ALL
		select PACKAGE_bluez-libs
		depends on !(USB_SUPPORT && USE_RFKILL) || USE_RFKILL
		depends on USB_SUPPORT
		select PACKAGE_kmod-bluetooth
		select PACKAGE_libc
		help
		 Bluelog is a simple Bluetooth scanner designed to tell you how many
		   discoverable devices there are in an area as quickly as possible. It is
		   intended to be used as a site survey tool, identifying the number of possible
		   Bluetooth targets there are in the surrounding environment.
		 https://github.com/MS3FGX/Bluelog
		 Nicolas Thill <nico@openwrt.org>

	config PACKAGE_bluelog-live
		tristate "bluelog-live.................. Bluetooth scanner and logger (live output)"
		default y if DEFAULT_bluelog-live
