		select PACKAGE_perl-netaddr-ip
		select PACKAGE_perlbase-mime
		help
		 SpamAssassin
		 https://spamassassin.apache.org/
		 Daniel Golle <daniel@makrotopia.org>

	config PACKAGE_spamc
