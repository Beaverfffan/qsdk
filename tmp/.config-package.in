		default y if DEFAULT_cgroup-tools
		default m if ALL
		select PACKAGE_libcgroup
		select PACKAGE_libc
		help
		 CGroup config and exec tools
		 Daniel Danzberger <daniel@dd-wrt.com>

	menuconfig PACKAGE_cgroupfs-mount
		tristate "cgroupfs-mount...................................... cgroup mount scripts"
		default y if DEFAULT_cgroupfs-mount
		default m if ALL
		select PACKAGE_mount-utils
		select PACKAGE_libc
		help
		 Simple scripts to properly mount the cgroupfs hierarchy, especially structured for Debian packaging
		 Gerard Ryan <G.M0N3Y.2503@gmail.com>


	
		config CGROUPFS_MOUNT_KERNEL_CGROUPS
			bool "Enable kernel cgroups support"
			depends on PACKAGE_cgroupfs-mount
			default y if ( DOCKER_KERNEL_OPTIONS || LXC_KERNEL_OPTIONS )
			select KERNEL_CGROUPS

	config PACKAGE_checkpolicy
		tristate "checkpolicy...................................... SELinux policy compiler"
		default y if DEFAULT_checkpolicy
		default m if ALL
		select PACKAGE_libc
		help
		 checkpolicy is the SELinux policy compiler. It uses libsepol
		 	to generate the binary policy. checkpolicy uses the static
		 	libsepol since it deals with low level details of the policy
		 	that have not been encapsulated/abstracted by a proper
		 	shared library interface.
		 http://selinuxproject.org/page/Main_Page
		 Thomas Petazzoni <thomas.petazzoni@bootlin.com>

	config PACKAGE_checksec
		tristate "checksec.......................... Utility to check PIE, RELRO, ASLR etc."
		default y if DEFAULT_checksec
		default m if ALL
		select PACKAGE_openssl-util
		select PACKAGE_bash
		select PACKAGE_procps-ng
		select PACKAGE_coreutils
		select PACKAGE_binutils
		select PACKAGE_coreutils-stat
		select PACKAGE_procps-ng-sysctl
		select PACKAGE_file
		select PACKAGE_libc
		help
		 Checksec is a bash script to check the properties
		   of executables (like PIE, RELRO, PaX, Canaries, ASLR, Fortify Source).
		 https://github.com/slimm609/checksec.sh
		 Jan Pavlinec <jan.pavlinec1@gmail.com>

	config PACKAGE_checksec_automator
		tristate "checksec_automator...................... Utility to use checksec for dirs"
		default y if DEFAULT_checksec_automator
		default m if ALL
		select PACKAGE_coreutils-tee
		select PACKAGE_libc
		select PACKAGE_findutils-find
		select PACKAGE_grep
		select PACKAGE_checksec
		help
		 Script for checksec directory scan.
		 https://github.com/slimm609/checksec.sh
		 Jan Pavlinec <jan.pavlinec1@gmail.com>

	config PACKAGE_chkcon
		tristate "chkcon.................. libsepol chkcon security context validation tool"
		default y if DEFAULT_chkcon
		default m if ALL
		select PACKAGE_libsepol
		select PACKAGE_libc
		help
		 chkcon - determine if a security context is valid for a given binary policy
		 http://selinuxproject.org/page/Main_Page
		 Thomas Petazzoni <thomas.petazzoni@bootlin.com>

	config PACKAGE_clocate
		tristate "clocate....... Determine device location using neighbouring WiFi networks"
		default y if DEFAULT_clocate
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libnl-tiny
		select PACKAGE_libjson-c
		select PACKAGE_libcurl
		help
		 This program can locate a device by sending the nighbouring WiFI networks
		 	to a geolocation Provider. Currently supported providers are Mozilla and Google.
		 David Bauer <mail@david-bauer.net>

	config PACKAGE_cmdpad
		tristate "cmdpad........... execute commands when key is pressed/released/held down"
		default y if DEFAULT_cmdpad
		default m if ALL
		select PACKAGE_libc
		help
		 cmdpad - execute commands when a key is pressed, released or hold down.
		 	Should be started from /etc/rc or /etc/rc.local. To run it as daemon you
		 	need to start it with '&'. All logs are printed to standard out and standard
		 	error (to write the log to disk use cmdpad > /var/log/cmdpad). Cmdpad
		 	searches for /etc/cmdpad.conf and load the key bindings. Then wait for
		 	key event and check each command to see if it should be run.
		 http://cmdpad.sourceforge.net/index.php
		 Ted Hess <thess@kitschensync.net>

	config PACKAGE_cni
		tristate "cni.................................................................. cni"
		default y if DEFAULT_cni
		default m if ALL
		select PACKAGE_libc
		depends on (aarch64||arm||i386||i686||mips||mips64||mips64el||mipsel||powerpc64||riscv64||x86_64)
		help
		 CNI (Container Network Interface), a Cloud Native Computing Foundation
		   project, consists of a specification and libraries for writing plugins to
		   configure network interfaces in Linux containers, along with a number of
		   supported plugins. CNI concerns itself only with network connectivity of
		   containers and removing allocated resources when the container is deleted.
		   Because of this focus, CNI has a wide range of support and the specification
		   is simple to implement.
		 https://github.com/containernetworking/cni
		 Daniel Golle <daniel@makrotopia.org>, Paul Spooren <mail@aparcar.org>, Oskari Rauta <oskari.rauta@gmail.com>

	config PACKAGE_cni-plugins
		tristate "cni-plugins.................................................. cni-plugins"
		default y if DEFAULT_cni-plugins
		default m if ALL
		depends on (aarch64||arm||i386||i686||mips||mips64||mips64el||mipsel||powerpc64||riscv64||x86_64)
		select PACKAGE_libc
		select PACKAGE_kmod-veth
		select PACKAGE_ip-full
		help
		 Some CNI network plugins, maintained by the containernetworking team. For
		   more information, see the individual READMEs.
		 https://github.com/containernetworking/cni-plugins
		 Daniel Golle <daniel@makrotopia.org>, Paul Spooren <mail@aparcar.org>

	config PACKAGE_cni-plugins-nft
		tristate "cni-plugins-nft..................... CNI Plugins compatible with nftables"
		default y if DEFAULT_cni-plugins-nft
		default m if ALL
		depends on !(PACKAGE_nftables-json<PACKAGE_cni-plugins-nft && IPV6) || IPV6
		select PACKAGE_nftables-nojson if PACKAGE_nftables-json<PACKAGE_cni-plugins-nft
		depends on (aarch64||arm||i386||i686||mips||mips64||mips64el||mipsel||powerpc64||riscv64||x86_64)
		select PACKAGE_libc
		help
		 CNI Plugins maintained by the CNI team do not support nftables, except when used with systemd.
		   These plugins do.
		     - cni-nftables-portmap
		     - cni-nftables-firewall
		 https://github.com/greenpau/cni-plugins/
		 Oskari Rauta <oskari.rauta@gmail.com>

	config PACKAGE_coap-client
		tristate "coap-client.................................. CoAP (RFC 7252) client tool"
		default y if DEFAULT_coap-client
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libcoap
		help
		 Constrained Application Protocol (RFC7252) client tool
		 Anton Glukhov <anton.a.glukhov@gmail.com>

	menuconfig PACKAGE_collectd
		tristate "collectd................. Lightweight system statistics collection daemon"
		default y if DEFAULT_collectd
		default m if ALL
		select PACKAGE_libpthread
		select PACKAGE_liblua if PACKAGE_collectd-mod-lua
		select PACKAGE_zlib
		select PACKAGE_libltdl
		select PACKAGE_jshn
		select PACKAGE_libc
		help
		 collectd is a small daemon which collects system information periodically
		  and provides mechanismns to store the values in a variety of ways.
		 https://collectd.org/
		 Jo-Philipp Wich <jo@mein.io>, Hannu Nyman <hannu.nyman@iki.fi>


	
		config PACKAGE_COLLECTD_ENCRYPTED_NETWORK
		bool "Enable ability to use encrypted networking"
		default n
		depends on PACKAGE_collectd
		select PACKAGE_collectd-mod-network
	
		config PACKAGE_COLLECTD_DEBUG_OUTPUT_ENABLE
		bool "Enable debug output"
		default n
		depends on PACKAGE_collectd
		help
		  Enables the compiler option that collectd is compiled with
		  debugging support. This is used at development stages to get
		  more messages from the collectd during development.

