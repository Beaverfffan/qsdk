	config PACKAGE_pbr
		tristate "pbr................ Policy Based Routing Service with nft/nft set support"
		default y if DEFAULT_pbr
		default m if ALL
		select PACKAGE_nftables-json
		select PACKAGE_kmod-nft-nat
		select PACKAGE_resolveip
		select PACKAGE_libc
		select PACKAGE_jshn
		select PACKAGE_ip-full
		select PACKAGE_kmod-nft-core
		select PACKAGE_jsonfilter
		help
		 This service enables policy-based routing for WAN interfaces and various VPN tunnels.
		 This version supports OpenWrt with both firewall3/ipset/iptables and firewall4/nft.
		 https://docs.openwrt.melmac.net/pbr/
		 Stan Grishin <stangri@melmac.ca>

	config PACKAGE_pbr-iptables
		tristate "pbr-iptables.... Policy Based Routing Service with iptables/ipset support"
		default y if DEFAULT_pbr-iptables
		default m if ALL
		depends on !(PACKAGE_iptables-zz-legacy<PACKAGE_pbr-iptables && IPV6) || IPV6
		select PACKAGE_iptables-nft if PACKAGE_iptables-zz-legacy<PACKAGE_pbr-iptables
		select PACKAGE_resolveip
		select PACKAGE_libc
		select PACKAGE_iptables-mod-ipopt
		select PACKAGE_jshn
		select PACKAGE_ipset
		select PACKAGE_jsonfilter
		select PACKAGE_kmod-ipt-ipset
		select PACKAGE_ip-full
		help
		 This service enables policy-based routing for WAN interfaces and various VPN tunnels.
		 This version supports OpenWrt with firewall3/ipset/iptables.
		 https://docs.openwrt.melmac.net/pbr/
		 Stan Grishin <stangri@melmac.ca>

	config PACKAGE_prince
		tristate "prince............................................................ Prince"
		default y if DEFAULT_prince
		default m if ALL
		select PACKAGE_libjson-c
		select PACKAGE_libc
		select PACKAGE_libpthread
		help
		 Prince is an open source implementation of the PopRouting Algorithm.
		   It has been developed as a Google Summer of Code Project in collaboration with Freifunk and the University of Trento.
		 
		   Prince fetches topology data from a Link State routing daemon (OONF, OLSR, OSPF, etc),
		   calculates the betweenness centrality using the topology and then computes the
		   the timers' optimal values using these data. At the end of the computation the timers are pushed back to the routing daemon.
		   Since v0.4 it supports both OONF and OLSRd.
		 https://github.com/AdvancedNetworkingSystems/prince
		 Gabriele Gemmi <gabriel@autistici.org>

	menuconfig PACKAGE_quagga
		tristate "quagga................................. The Quagga Software Routing Suite"
		default y if DEFAULT_quagga
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_librt
		help
		 A routing software package that provides TCP/IP based routing services
		   with routing protocols support such as RIPv1, RIPv2, RIPng, OSPFv2,
		   OSPFv3, BGP-4, and BGP-4+
		 https://www.quagga.net
		 Vasilis Tsiligiannis <acinonyx@openwrt.gr>

