endmenu
menu "Printing"
	config PACKAGE_p910nd
		tristate "p910nd............................... A small non-spooling printer server"
		default y if DEFAULT_p910nd
		default m if ALL
		select PACKAGE_libc
		help
		 p910nd is a small daemon that copies any data received on
		  the port it is listening on to the corresponding printer
		  port. It is primarily intended for diskless Linux hosts
		  running as printer drivers but there is no reason why it
		  could not be used on diskful hosts. Port 9100 is copied
		  to /dev/lp0, 9101 to /dev/lp1 and 9102 to /dev/lp2. The
		  default is port 9100 to /dev/lp0.
		 http://p910nd.sourceforge.net
		 Philipp Kerling <pkerling@casix.org>

endmenu
menu "Routing and Redirection"
	config PACKAGE_babel-pinger
		tristate "babel-pinger................................................ Babel-pinger"
		default y if DEFAULT_babel-pinger
		default m if ALL
		select PACKAGE_librt
		select PACKAGE_libc
		help
		 Babel-pinger is a hack to export a default route into Babel for people
		  using DHCP to configure their routers rather than speaking to their
		  upstream provider with a proper routing protocol.
		 http://www.pps.univ-paris-diderot.fr/~jch/software/babel/
		 Gabriel Kerneis <gabriel@kerneis.info>

	config PACKAGE_babeld
		tristate "babeld.................. A loop-avoiding distance-vector routing protocol"
		default y if DEFAULT_babeld
		default m if ALL
		depends on IPV6
		select PACKAGE_libubus
		select PACKAGE_libc
		select PACKAGE_libubox
		help
		 Babel is a loop-avoiding distance-vector routing protocol for IPv6 and IPv4
		   with fast convergence properties. It is based on the ideas in DSDV, AODV and
		   Cisco's EIGRP, but is designed to work well not only in wired networks but
		   also in wireless mesh networks, and has been extended with support for
		   overlay networks. Babel is an IETF standard protocol (RFC 8966).
		 https://www.irif.fr/~jch/software/babel/
		 Gabriel Kerneis <gabriel@kerneis.info>, Baptiste Jonglez <openwrt-pkg@bitsofnetworks.org>, Nick Hainke <vincent@systemli.org>

	config PACKAGE_batmand
		tristate "batmand.............................. B.A.T.M.A.N. layer 3 routing daemon"
		default y if DEFAULT_batmand
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libpthread
		select PACKAGE_kmod-tun
		help
		 B.A.T.M.A.N. layer 3 routing daemon
		 https://www.open-mesh.org/
		 Corinna "Elektra" Aichele <onelektra@gmx.net>

	config PACKAGE_bcp38
		tristate "bcp38................................................... BCP38 compliance"
		default y if DEFAULT_bcp38
		default m if ALL
		select PACKAGE_libc
		help
		 bcp38 implements IETF BCP38 for home routers.
		  See https://tools.ietf.org/html/bcp38.
		 
		  This package provides BCP38 for IPv4 only - IPv6 uses source
		  specific default routes, so no firewall configuration is needed.
		 https://github.com/dtaht/ceropackages-3.10
		 Toke Høiland-Jørgensen <toke@toke.dk>

	config PACKAGE_bfdd
		tristate "bfdd.......................................................... BFD daemon"
		default y if DEFAULT_bfdd
		default m if ALL
		select PACKAGE_libjson-c
		select PACKAGE_libevent2
		select PACKAGE_libc
		help
		 A port of Cumulus BFD daemon to a more portable daemon.
		 
		   Bidirectional Forwarding Detection (BFD) is a network protocol that is used to
		   detect faults between two forwarding engines connected by a link. It provides
		   low-overhead detection of faults even on physical media that doesn't support
		   failure detection of any kind, such as Ethernet, virtual circuits, tunnels and
		   MPLS Label Switched Paths.
		 https://github.com/rzalamena/bfdd
		 Lucian Cristian <lucian.cristian@gmail.com>

	config PACKAGE_bird1-ipv4
		tristate "bird1-ipv4................ The BIRD Internet Routing Daemon (v1.6) (IPv4)"
		default y if DEFAULT_bird1-ipv4
		default m if ALL
		select PACKAGE_libpthread
		select PACKAGE_libc
		help
		 BIRD is an internet routing daemon which manages TCP/IP routing tables
		 with support of modern routing protocols, easy to use configuration
		 interface and powerful route filtering language. It is lightweight and
		 efficient and therefore appropriate for small embedded routers.
		 
		 This packages the legacy v1.6 branch of Bird, which splits IPv4 and IPv6
		 support into separate binaries. See also the bird2 package for the newer
		 branch which integrates support for both IP protocols in a single binary.
		 
		 This is IPv4 version of BIRD, it supports OSPFv2, RIPv2 and BGP
		 protocols.
		 
		 In BGP, BIRD supports communities, multiprotocol extensions, MD5
		 authentication, 32bit AS numbers and could act as a route server or a
		 route reflector. BIRD also supports multiple RIBs, multiple kernel
		 routing tables and redistribution between the protocols with a powerful
		 configuration syntax.
		 
		 https://bird.network.cz/
		 Álvaro Fernández Rojas <noltari@gmail.com>

	config PACKAGE_bird1-ipv4-uci
		tristate "bird1-ipv4-uci......................... The BIRD UCI module (v1.6) (IPv4)"
		default y if DEFAULT_bird1-ipv4-uci
		default m if ALL
		select PACKAGE_libuci
		select PACKAGE_bird1-ipv4
		select PACKAGE_libc
		select PACKAGE_uci
		help
		 The BIRD UCI module (v1.6) (IPv4)
		 https://github.com/openwrt/bird1-openwrt/
		 Roger Pueyo Centelles <roger.pueyo@guifi.net>

	config PACKAGE_bird1-ipv6
		tristate "bird1-ipv6................ The BIRD Internet Routing Daemon (v1.6) (IPv6)"
		default y if DEFAULT_bird1-ipv6
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libpthread
		help
		 BIRD is an internet routing daemon which manages TCP/IP routing tables
		 with support of modern routing protocols, easy to use configuration
		 interface and powerful route filtering language. It is lightweight and
		 efficient and therefore appropriate for small embedded routers.
		 
		 This packages the legacy v1.6 branch of Bird, which splits IPv4 and IPv6
		 support into separate binaries. See also the bird2 package for the newer
		 branch which integrates support for both IP protocols in a single binary.
		 
		 This is IPv6 version of BIRD, it supports OSPFv3, RIPng and BGP
		 protocols.
		 
		 In BGP, BIRD supports communities, multiprotocol extensions, MD5
		 authentication, 32bit AS numbers and could act as a route server or a
		 route reflector. BIRD also supports multiple RIBs, multiple kernel
		 routing tables and redistribution between the protocols with a powerful
		 configuration syntax.
		 
		 https://bird.network.cz/
		 Álvaro Fernández Rojas <noltari@gmail.com>

	config PACKAGE_bird1-ipv6-uci
		tristate "bird1-ipv6-uci......................... The BIRD UCI module (v1.6) (IPv6)"
		default y if DEFAULT_bird1-ipv6-uci
		default m if ALL
		select PACKAGE_libuci
		select PACKAGE_libc
		select PACKAGE_uci
