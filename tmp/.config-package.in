		default y if DEFAULT_dnscrypt-proxy-resolvers
		default m if ALL
		select PACKAGE_libc
		help
		 Package with current list of dnscrypt-proxy resolvers.
		 https://github.com/dyne/dnscrypt-proxy
		 Damiano Renfer <x9w2n7xnu@relay.firefox.com>

	config PACKAGE_dnsdist
		tristate "dnsdist"
		default y if DEFAULT_dnsdist
		default m if ALL
		select PACKAGE_ca-bundle
		select PACKAGE_libopenssl if DNSDIST_OPENSSL
		select PACKAGE_libatomic
		select PACKAGE_libstdcpp
		select PACKAGE_luajit
		select PACKAGE_libedit if DNSDIST_LIBEDIT
		select PACKAGE_libgnutls if DNSDIST_GNUTLS
		select PACKAGE_re2 if DNSDIST_RE2
		select PACKAGE_lmdb if DNSDIST_LMDB
		depends on (i386||x86_64||arm||armeb||aarch64||powerpc||mips||mipsel||mips64)
		select PACKAGE_libnetsnmp if DNSDIST_NET_SNMP
		select PACKAGE_libcap
		select PACKAGE_libsodium if DNSDIST_SODIUM
		select PACKAGE_libc
		select PACKAGE_libfstrm if DNSDIST_DNSTAP
		select PACKAGE_tinycdb if DNSDIST_CDB
		select PACKAGE_libnghttp2 if DNSDIST_DNS_OVER_HTTPS
		help
		 dnsdist is a highly DNS-, DoS- and abuse-aware loadbalancer. Its goal in life
		   is to route traffic to the best server, delivering top performance to legitimate
		   users while shunting or blocking abusive traffic.
		 https://dnsdist.org/
		 Peter van Dijk <peter.van.dijk@powerdns.com>


	
	  source "qca/feeds/packages/net/dnsdist/Config.in"

