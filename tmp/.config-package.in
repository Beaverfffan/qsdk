		help
		 lm-sensors libraries
		 https://hwmon.wiki.kernel.org/lm_sensors
		 Jo-Philipp Wich <jo@mein.io>

	config PACKAGE_libsepol
		tristate "libsepol...................... SELinux binary policy manipulation library"
		default y if DEFAULT_libsepol
		default m if ALL
		select PACKAGE_libc
		help
		 Libsepol is the binary policy manipulation library. It doesn't
		 	depend upon or use any of the other SELinux components.
		 http://selinuxproject.org/page/Main_Page
		 Thomas Petazzoni <thomas.petazzoni@bootlin.com>

	config PACKAGE_libshout
		tristate "libshout............................ Shoutcast client library (no theora)"
		default y if DEFAULT_libshout
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libopenssl
		select PACKAGE_libpthread
		select PACKAGE_libvorbisidec
		help
		 libshout allows applications to easily communicate and broadcast
		  to an Icecast streaming media server. It handles the socket connections,
		  metadata communication, and data streaming for the calling application,
		  and lets developers focus on feature sets instead of implementation
		  details.
