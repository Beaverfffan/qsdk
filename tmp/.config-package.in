	config PACKAGE_libupm-sht1x-python3
		tristate "libupm-sht1x-python3............................... sht1x Python3 library"
		default y if DEFAULT_libupm-sht1x-python3
		default m if ALL
		depends on !powerpc
		depends on !armeb
		select PACKAGE_libmraa-python3
		depends on !arc
		select PACKAGE_libmraa
		select PACKAGE_libc
		depends on !riscv64
		select PACKAGE_python3-light
		select PACKAGE_libupm-sht1x
		select PACKAGE_librt
		select PACKAGE_libupm-utilities
		help
		 UPM is a high level repository that provides software drivers for a wide variety
		 of commonly used sensors and actuators. These software drivers interact with the
		 underlying hardware platform through calls to MRAA APIs.
		   MRAA that allows you to use various sensors on platforms such as the Intel Galileo,
		 Intel Edison, Minnowboard MAX and others.
		 
		 This package contains sht1x sensor Python3 library
		 https://github.com/intel-iot-devkit/upm
		 John Crispin <blogic@openwrt.org>, Hirokazu MORIKAWA <morikw2@gmail.com>

