	config PACKAGE_catatonit
		tristate "catatonit"
		default y if DEFAULT_catatonit
		default m if ALL
		select PACKAGE_libc
		help
		 This is a rewrite of initrs in C, because we found that it is not
		   possible to statically compile Rust binaries without using musl.
		   That was, in turn, a reimplementation of other container inits like
		   tini and dumb-init.
		 https://github.com/openSUSE/catatonit
		 Oskari Rauta <oskari.rauta@gmail.com>

	config PACKAGE_cgroup-tools
