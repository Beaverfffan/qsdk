	config PACKAGE_borgbackup
		tristate "borgbackup. Deduplicated, encrypted, authenticated and compressed backups"
		default y if DEFAULT_borgbackup
		default m if ALL
		select PACKAGE_python3-readline
		select PACKAGE_python3-unittest
		select PACKAGE_python3-uuid
		select PACKAGE_libacl
		select PACKAGE_python3-pyfuse3
		select PACKAGE_libxxhash
		select PACKAGE_liblz4
		select PACKAGE_python3-msgpack
		select PACKAGE_python3-logging
		select PACKAGE_python3-email
		select PACKAGE_libc
		select PACKAGE_python3-codecs
		select PACKAGE_libzstd
		select PACKAGE_libopenssl
		select PACKAGE_python3-lzma
		select PACKAGE_python3-light
		select PACKAGE_python3-urllib
		select PACKAGE_python3-packaging
		help
		 BorgBackup (short: Borg) is a deduplicating backup program.
		   Optionally, it supports compression and authenticated encryption.
		 
		   The main goal of Borg is to provide an efficient and secure way to backup data.
		   The data deduplication technique used makes Borg suitable for daily backups since only changes are stored. The authenticated encryption technique makes it suitable for backups to not fully trusted targets.
		 https://github.com/borgbackup/borg
		 Julien Malik <julien.malik@paraiso.me>

	config PACKAGE_borgbackup-src
		tristate "borgbackup-src"
		default y if DEFAULT_borgbackup-src
		default m if ALL
		select PACKAGE_libc
		help
		 BorgBackup (short: Borg) is a deduplicating backup program.
		   Optionally, it supports compression and authenticated encryption.
		 
		   The main goal of Borg is to provide an efficient and secure way to backup data.
		   The data deduplication technique used makes Borg suitable for daily backups since only changes are stored. The authenticated encryption technique makes it suitable for backups to not fully trusted targets.
		 
		     This package contains the Python source files for borgbackup.
		 https://github.com/borgbackup/borg
		 Julien Malik <julien.malik@paraiso.me>


	
	    depends on PACKAGE_borgbackup

