	config PACKAGE_lighttpd-mod-auth
		tristate "lighttpd-mod-auth.................................. Authentication module"
		default y if DEFAULT_lighttpd-mod-auth
		default m if ALL
		select PACKAGE_libnettle if LIGHTTPD_CRYPTOLIB_NETTLE
		select PACKAGE_libwolfssl if LIGHTTPD_CRYPTOLIB_WOLFSSL && PACKAGE_libwolfsslcpu-crypto<PACKAGE_lighttpd-mod-auth
		select PACKAGE_libmbedtls if LIGHTTPD_CRYPTOLIB_MBEDTLS
		depends on PACKAGE_lighttpd
		select PACKAGE_libc
		help
		 Authentication module
		 https://www.lighttpd.net/
		 Glenn Strauss <gstrauss@gluelogic.com>

	config PACKAGE_lighttpd-mod-authn_dbi
		tristate "lighttpd-mod-authn_dbi................... DBI-based authentication module"
		default y if DEFAULT_lighttpd-mod-authn_dbi
		default m if ALL
		select PACKAGE_libmbedtls if LIGHTTPD_CRYPTOLIB_MBEDTLS
		depends on PACKAGE_lighttpd
		depends on PACKAGE_lighttpd-mod-auth
		select PACKAGE_libwolfssl if LIGHTTPD_CRYPTOLIB_WOLFSSL && PACKAGE_libwolfsslcpu-crypto<PACKAGE_lighttpd-mod-authn_dbi
		select PACKAGE_libc
		select PACKAGE_libnettle if LIGHTTPD_CRYPTOLIB_NETTLE
		depends on PACKAGE_libdbi
		help
		 DBI-based authentication module
		 https://www.lighttpd.net/
		 Glenn Strauss <gstrauss@gluelogic.com>

	config PACKAGE_lighttpd-mod-authn_file
		tristate "lighttpd-mod-authn_file................. File-based authentication module"
		default y if DEFAULT_lighttpd-mod-authn_file
		default m if ALL
		select PACKAGE_libmbedtls if LIGHTTPD_CRYPTOLIB_MBEDTLS
		depends on PACKAGE_lighttpd
		depends on PACKAGE_lighttpd-mod-auth
		select PACKAGE_libnettle if LIGHTTPD_CRYPTOLIB_NETTLE
		select PACKAGE_libc
		select PACKAGE_libwolfssl if LIGHTTPD_CRYPTOLIB_WOLFSSL && PACKAGE_libwolfsslcpu-crypto<PACKAGE_lighttpd-mod-authn_file
		help
		 File-based authentication module
		 https://www.lighttpd.net/
		 Glenn Strauss <gstrauss@gluelogic.com>

	config PACKAGE_lighttpd-mod-authn_gssapi
		tristate "lighttpd-mod-authn_gssapi........... Kerberos-based authentication module"
		default y if DEFAULT_lighttpd-mod-authn_gssapi
		default m if ALL
		select PACKAGE_libwolfssl if LIGHTTPD_CRYPTOLIB_WOLFSSL && PACKAGE_libwolfsslcpu-crypto<PACKAGE_lighttpd-mod-authn_gssapi
