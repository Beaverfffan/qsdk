		select PACKAGE_libarchive if SAMBA4_SERVER_AD_DC
		select PACKAGE_libreadline
		select PACKAGE_jansson if SAMBA4_SERVER_AD_DC
		select PACKAGE_libavahi-client if SAMBA4_SERVER_AVAHI
		select PACKAGE_attr if SAMBA4_SERVER_AD_DC
