	config PACKAGE_python3-charset-normalizer
		tristate "python3-charset-normalizer......... Real First Universal Charset Detector"
		default y if DEFAULT_python3-charset-normalizer
		default m if ALL
		select PACKAGE_python3-logging
		select PACKAGE_python3-codecs
		select PACKAGE_libc
		select PACKAGE_python3-light
		help
		 A library that helps you read text from an unknown charset encoding.
		 Motivated by chardet, I'm trying to resolve the issue by taking a new
