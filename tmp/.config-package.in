		select PACKAGE_procps-ng-ps
		select PACKAGE_kea-dhcp6 if IPV6
		select PACKAGE_procps-ng
		select PACKAGE_libc
		select PACKAGE_kea-dhcp4
		help
		 Tool to start, stop, reconfigure, and report status for the Kea servers.
		 https://www.isc.org/kea
		 BangLang Huang <banglang.huang@foxmail.com>, Rosy Song <rosysong@rosinson.com>

	config PACKAGE_kea-dhcp-ddns
