	menuconfig PACKAGE_dockerd
		tristate "dockerd.................................. Docker Community Edition Daemon"
		default y if DEFAULT_dockerd
		default m if ALL
		select PACKAGE_kmod-ipt-nat6 if IPV6
		depends on !(IPV6 && PACKAGE_ip6tables-zz-legacy<PACKAGE_dockerd) || IPV6
		select PACKAGE_libseccomp if KERNEL_SECCOMP
		depends on (aarch64||arm||i386||i686||mips||mips64||mips64el||mipsel||powerpc64||riscv64||x86_64)
		select PACKAGE_iptables-nft if PACKAGE_iptables-zz-legacy<PACKAGE_dockerd
		depends on !(IPV6 && PACKAGE_ip6tables-zz-legacy<PACKAGE_dockerd && IPV6) || IPV6
		select PACKAGE_iptables-mod-extra
		depends on !(PACKAGE_iptables-zz-legacy<PACKAGE_dockerd && IPV6) || IPV6
		select PACKAGE_kmod-nf-ipvs
		select PACKAGE_ip6tables-nft if IPV6 && PACKAGE_ip6tables-zz-legacy<PACKAGE_dockerd
		select PACKAGE_kmod-veth
		select PACKAGE_libc
		select PACKAGE_ca-certificates
		select PACKAGE_kmod-ipt-nat
		depends on !(mips||mipsel)
		select PACKAGE_containerd
		select PACKAGE_firewall if PACKAGE_firewall4<PACKAGE_dockerd
		select PACKAGE_kmod-ipt-physdev
		depends on IPV6
		select PACKAGE_tini
		help
		 The Docker CE Engine.
		 https://www.docker.com/
		 Gerard Ryan <G.M0N3Y.2503@gmail.com>


	
	  source "qca/feeds/packages/utils/dockerd/Config.in"

