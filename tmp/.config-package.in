		 Nick Hainke <vincent@systemli.org>

	config PACKAGE_wifi-presence
		tristate "wifi-presence.... WiFi presence detection with Home Assistant integration"
		default y if DEFAULT_wifi-presence
		default m if ALL
		depends on (aarch64||arm||i386||i686||mips||mips64||mips64el||mipsel||powerpc64||riscv64||x86_64)
		select PACKAGE_libc
		help
		 WiFi presence detection with Home Assistant integration.
		   Publish WiFi client connect and disconnect events to MQTT.
		 https://github.com/awilliams/wifi-presence
		 Adam Williams <pwnfactory@gmail.com>

	config PACKAGE_wpan-tools
		tristate "wpan-tools..................... cfg802154 interface configuration utility"
		default y if DEFAULT_wpan-tools
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libnl
		help
		 cfg802154 interface configuration utility
		 https://linux-wpan.org/wpan-tools.html
		 

	config PACKAGE_wwan
		tristate "wwan................................. Generic OpenWrt 3G/4G proto handler"
		default y if DEFAULT_wwan
		default m if ALL
		select PACKAGE_libc
		help
		 Generic OpenWrt 3G/4G proto handler
		 John Crispin <john@phrozen.org>

	config PACKAGE_xdp-filter
		tristate "xdp-filter............... xdp-filter - a simple XDP-powered packet filter"
		default y if DEFAULT_xdp-filter
		default m if ALL||ALL_NONSHARED
		select PACKAGE_libxdp
		depends on HAS_BPF_TOOLCHAIN
		select PACKAGE_libc
		help
		 xdp-filter is a packet filtering utility powered by XDP. It is deliberately
		 simple and so does not have the same matching capabilities as, e.g.,
		 netfilter. Instead, thanks to XDP, it can achieve very high drop rates:
		 tens of millions of packets per second on a single CPU core.
		 https://github.com/xdp-project/xdp-tools/
		 Daniel Golle <daniel@makrotopia.org>

	config PACKAGE_xdp-loader
		tristate "xdp-loader............................ xdp-loader - an XDP program loader"
		default y if DEFAULT_xdp-loader
		default m if ALL||ALL_NONSHARED
		select PACKAGE_libxdp
		depends on HAS_BPF_TOOLCHAIN
		select PACKAGE_libc
		help
		 xdp-loader is a simple loader for XDP programs with support for attaching
		 multiple programs to the same interface. To achieve this it exposes the same
		 load and unload semantics exposed by the libxdp library.
		 https://github.com/xdp-project/xdp-tools/
		 Daniel Golle <daniel@makrotopia.org>

	config PACKAGE_xdpdump
		tristate "xdpdump............ xdpdump - tool for capturing packets at the XDP layer"
		default y if DEFAULT_xdpdump
		default m if ALL||ALL_NONSHARED
		select PACKAGE_libxdp
		select PACKAGE_libc
		depends on HAS_BPF_TOOLCHAIN
		select PACKAGE_libpcap
		help
		 xdpdump - a simple tcpdump like tool for capturing packets at the XDP layer
		 https://github.com/xdp-project/xdp-tools/
		 Daniel Golle <daniel@makrotopia.org>

	config PACKAGE_xfrm
		tristate "xfrm.......................... XFRM IPsec Tunnel Interface config support"
		default y if DEFAULT_xfrm
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_kmod-xfrm-interface
		depends on PACKAGE_kmod-ipsec
		depends on IPV6
		help
		 XFRM IPsec Tunnel Interface config support (IPv4 and IPv6) in /etc/config/network.
		 Andre Valentin <avalentin@marcant.net>

	config PACKAGE_xinetd
		tristate "xinetd................................ A powerful and secure super-server"
		default y if DEFAULT_xinetd
		default m if ALL
		select PACKAGE_libc
		help
		 xinetd has access control mechanisms, extensive logging capabilities,
		 	the ability to make services available based on time, can place limits
		 	on the number of servers that can be started, and has deployable
		 	defence mechanisms to protect against port scanners, among other
		 	things.
		 https://github.com/xinetd-org
		 Florian Eckert <fe@dev.tdt.de>

	config PACKAGE_xray-core
		tristate "xray-core. A platform for building proxies to bypass network restrictions"
		default y if DEFAULT_xray-core
		default m if ALL
		select PACKAGE_ca-bundle
		depends on (aarch64||arm||i386||i686||mips||mips64||mips64el||mipsel||powerpc64||riscv64||x86_64)
		select PACKAGE_libc
		help
		 Xray, Penetrates Everything. It helps you to build your own computer network.
		   It secures your network connections and thus protects your privacy.
		 https://xtls.github.io
		 Tianling Shen <cnsztl@immortalwrt.org>

	config PACKAGE_xray-example
		tristate "xray-example"
		default y if DEFAULT_xray-example
		default m if ALL
		select PACKAGE_libc
		depends on PACKAGE_xray-core
		help
		 Xray, Penetrates Everything. It helps you to build your own computer network.
		   It secures your network connections and thus protects your privacy.
		 
		   This includes example configuration files for xray-core.
		 https://xtls.github.io
		 Tianling Shen <cnsztl@immortalwrt.org>

	config PACKAGE_ztdns
		tristate "ztdns........................................................ ZerotierDNS"
		default y if DEFAULT_ztdns
		default m if ALL
		select PACKAGE_libc
		depends on (aarch64||arm||i386||i686||mips||mips64||mips64el||mipsel||powerpc64||riscv64||x86_64)
		help
		 ztDNS is a dedicated DNS server for a ZeroTier virtual network.
		   It is alternative to Zerotier's own zeronsd.
		 https://github.com/uxbh/ztdns
		 Oskari Rauta <oskari.rauta@gmail.com>

endmenu

