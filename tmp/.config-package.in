		 Ted Hess <thess@kitschensync.net>

	config PACKAGE_avahi-dbus-daemon
		tristate "avahi-dbus-daemon................. An mDNS/DNS-SD implementation (daemon)"
		default y if DEFAULT_avahi-dbus-daemon
		default m if ALL
		select PACKAGE_libavahi-dbus-support
		select PACKAGE_libdaemon
