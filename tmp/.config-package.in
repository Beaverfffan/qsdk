		 https://netfilter.org/
		 

	config PACKAGE_fwknop
		tristate "fwknop.................................... FireWall KNock OPerator Client"
		default y if DEFAULT_fwknop
		default m if ALL
		select PACKAGE_libgpgme if FWKNOPD_GPG
		select PACKAGE_libc
		select PACKAGE_gnupg if FWKNOPD_GPG
		select PACKAGE_libfko
		help
		 Fwknop implements an authorization scheme known as Single Packet Authorization
		   (SPA) for Linux systems running iptables.  This mechanism requires only a
		   single encrypted and non-replayed packet to communicate various pieces of
		   information including desired access through an iptables policy. The main
		   application of this program is to use iptables in a default-drop stance to
		   protect services such as SSH with an additional layer of security in order to
		   make the exploitation of vulnerabilities (both 0-day and unpatched code) much
		   more difficult.
		   This package contains the fwknop client.
		 https://www.cipherdyne.org/fwknop/
		 Jonathan Bennett <JBennett@incomsystems.biz>

	config PACKAGE_fwknopd
		tristate "fwknopd................................... FireWall KNock OPerator Daemon"
		default y if DEFAULT_fwknopd
		default m if ALL
		select PACKAGE_iptables-mod-nfqueue if FWKNOPD_NFQ_CAPTURE
		select PACKAGE_libgpgme if FWKNOP_GPG
		depends on !(PACKAGE_iptables-zz-legacy<PACKAGE_fwknopd && IPV6) || IPV6
		select PACKAGE_libfko
		select PACKAGE_gnupg if FWKNOP_GPG
		select PACKAGE_libpcap if !FWKNOPD_NFQ_CAPTURE
		select PACKAGE_libc
		select PACKAGE_libnetfilter-queue if FWKNOPD_NFQ_CAPTURE
		select PACKAGE_libnfnetlink if FWKNOPD_NFQ_CAPTURE
		select PACKAGE_iptables-nft if PACKAGE_iptables-zz-legacy<PACKAGE_fwknopd
		help
		 Fwknop implements an authorization scheme known as Single Packet Authorization
		   (SPA) for Linux systems running iptables.  This mechanism requires only a
		   single encrypted and non-replayed packet to communicate various pieces of
		   information including desired access through an iptables policy. The main
		   application of this program is to use iptables in a default-drop stance to
		   protect services such as SSH with an additional layer of security in order to
		   make the exploitation of vulnerabilities (both 0-day and unpatched code) much
		   more difficult.
		   This package contains the fwknop daemon.
		 https://www.cipherdyne.org/fwknop/
		 Jonathan Bennett <JBennett@incomsystems.biz>


	
		source "qca/feeds/packages/net/fwknop/Config.in"

