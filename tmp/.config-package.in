		select PACKAGE_libnatpmp if KADNODE_ENABLE_NATPMP
		select PACKAGE_libmbedtls if KADNODE_ENABLE_TLS
		select PACKAGE_libmbedtls if KADNODE_ENABLE_BOB
		select PACKAGE_libc
		help
		 A P2P DNS system based on the BitTorrent network. It can be used as a decentralized DynDNS service.
		 https://github.com/mwarning/KadNode
		 Moritz Warning <moritzwarning@web.de>


	
		source "qca/feeds/packages/net/kadnode/Config.in"

	config PACKAGE_kea-admin
