		 Christian Pointner <equinox@spreadspace.org>

	config PACKAGE_vpnc
		tristate "vpnc........................................ VPN client for Cisco EasyVPN"
		default y if DEFAULT_vpnc
		default m if ALL
		select PACKAGE_libgnutls if VPNC_GNUTLS
		select PACKAGE_libgpg-error
		select PACKAGE_resolveip
		select PACKAGE_libc
		select PACKAGE_libgcrypt
		select PACKAGE_kmod-tun
		select PACKAGE_vpnc-scripts
		select PACKAGE_libopenssl if VPNC_OPENSSL
		help
		 A VPN client compatible with Cisco's EasyVPN equipment.
		 
		 	Supports IPSec (ESP) with Mode Configuration and Xauth.  Supports only
		 	shared-secret IPSec authentication with Xauth, AES (256, 192, 128),
		 	3DES, 1DES, MD5, SHA1, DH1/2/5/14/15/16/17/18 and IP tunneling.
		 https://davidepucci.it/doc/vpnc/
		 Daniel Gimpelevich <daniel@gimpelevich.san-francisco.ca.us>


	
		source "qca/feeds/packages/net/vpnc/Config.in"

	config PACKAGE_vpnc-scripts
		tristate "vpnc-scripts........... VPN configuration script for vpnc and OpenConnect"
		default y if DEFAULT_vpnc-scripts
		default m if ALL
		select PACKAGE_libc
		help
		 This package contains the vpnc-script which is used by vpnc
		 	and OpenConnect to configure the tunnel interface.
		 Nikos Mavrogiannopoulos <n.mavrogiannopoulos@gmail.com>

	config PACKAGE_wireguard-tools
		tristate "wireguard-tools................. WireGuard userspace control program (wg)"
		default y if DEFAULT_wireguard-tools
		default m if ALL
		select BUSYBOX_CONFIG_IP
		select BUSYBOX_CONFIG_FEATURE_IP_LINK
		select PACKAGE_libc
		select PACKAGE_kmod-wireguard
		help
		 WireGuard is a novel VPN that runs inside the Linux Kernel and utilizes
		   state-of-the-art cryptography. It aims to be faster, simpler, leaner, and
		   more useful than IPSec, while avoiding the massive headache. It intends to
		   be considerably more performant than OpenVPN.  WireGuard is designed as a
		   general purpose VPN for running on embedded interfaces and super computers
		   alike, fit for many different circumstances. It uses UDP.
		 
		   This package provides the userspace control program for WireGuard,
		   `wg(8)`, a netifd protocol helper, and a re-resolve watchdog script.
		 https://www.wireguard.com
		 Jason A. Donenfeld <Jason@zx2c4.com>

	config PACKAGE_xl2tpd
		tristate "xl2tpd....................... An L2TP (Layer 2 Tunneling Protocol) daemon"
		default y if DEFAULT_xl2tpd
		default m if ALL
		depends on (PACKAGE_ppp||PACKAGE_ppp-multilink)
		select PACKAGE_ppp-mod-pppol2tp
		depends on PACKAGE_kmod-ppp
		select PACKAGE_resolveip
		select PACKAGE_libc
		help
		 l2tpd is the open source implementation of the L2TP tunneling protocol (RFC2661).
		 It does implement both LAC and LNS role in a L2TP networking architecture. The
		 main goal of this protocol is to tunnel PPP frame trough an IP network.
		 http://www.xelerance.com/software/xl2tpd/
		 Yousong Zhou <yszhou4tech@gmail.com>

	config PACKAGE_zerotier
		tristate "zerotier.. Create flat virtual Ethernet networks of almost unlimited size"
		default y if DEFAULT_zerotier
		default m if ALL
		select PACKAGE_ip-tiny if PACKAGE_ip-full<PACKAGE_zerotier
		select PACKAGE_libc
		select PACKAGE_libpthread
		select PACKAGE_kmod-tun
		select PACKAGE_libnatpmp
		select PACKAGE_libminiupnpc
		select PACKAGE_libatomic
		select PACKAGE_libstdcpp
		help
		 ZeroTier creates a global provider-independent virtual private cloud network.
		 https://www.zerotier.com
		 Moritz Warning <moritzwarning@web.de>


	
		source "qca/feeds/packages/net/zerotier/Config.in"

endmenu
menu "Version Control Systems"
	config PACKAGE_git
		tristate "git...................................... The fast version control system"
		default y if DEFAULT_git
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_librt
		select PACKAGE_libpthread
		select PACKAGE_libopenssl
		select PACKAGE_zlib
		help
		 Git is a free & open source, distributed version control system
		  designed to handle everything from small to very large projects
		  with speed and efficiency.
		 https://git-scm.com
		 Peter Wagner <tripolar@gmx.at>

	config PACKAGE_git-gitweb
		tristate "git-gitweb.................................. Git repository web interface"
		default y if DEFAULT_git-gitweb
		default m if ALL
		select PACKAGE_perlbase-file
		select PACKAGE_perlbase-time
		select PACKAGE_librt
		select PACKAGE_git
		depends on PACKAGE_perl
		select PACKAGE_perlbase-digest
		select PACKAGE_perlbase-essential
		select PACKAGE_perlbase-fcntl
		select PACKAGE_zlib
		select PACKAGE_perlbase-encode
		select PACKAGE_libopenssl
		select PACKAGE_libpthread
		select PACKAGE_perlbase-storable
		select PACKAGE_perlbase-filetest
		select PACKAGE_libc
		select PACKAGE_perl-cgi
		help
		 Git is a free & open source, distributed version control system
		  designed to handle everything from small to very large projects
		  with speed and efficiency.
		  This package builds the gitweb web interface for git repositories
		 https://git-scm.com
		 Peter Wagner <tripolar@gmx.at>

	config PACKAGE_git-http
		tristate "git-http............................................... Git HTTP commands"
		default y if DEFAULT_git-http
		default m if ALL
		select PACKAGE_libpthread
		select PACKAGE_librt
		select PACKAGE_libopenssl
		select PACKAGE_zlib
		select PACKAGE_git
		select PACKAGE_libc
		select PACKAGE_libcurl
		help
		 Git is a free & open source, distributed version control system
		  designed to handle everything from small to very large projects
		  with speed and efficiency.
		 
		  This package allows git push/fetch over http(s) and ftp(s)
		 https://git-scm.com
		 Peter Wagner <tripolar@gmx.at>

	config PACKAGE_gitolite
		tristate "gitolite......................... Easy administration of git repositories"
		default y if DEFAULT_gitolite
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_perlbase-storable
		select PACKAGE_perlbase-getopt
		select PACKAGE_perlbase-env
		select PACKAGE_perlbase-essential
		select PACKAGE_perlbase-text
		select PACKAGE_perlbase-data
		select PACKAGE_git
		select PACKAGE_perlbase-utf8
		select PACKAGE_perlbase-mime
		select PACKAGE_perlbase-digest
		depends on PACKAGE_perl
		select PACKAGE_perlbase-findbin
		select PACKAGE_perlbase-sys
		select PACKAGE_perlbase-time
		help
		 Gitolite is a system for managing access to git repositories.
		   See https://openwrt.org/docs/guide-user/services/gitolite for a guide
		   to installation.
		   NB: You will need an SSH server to use gitolite: dropbear is now sufficient
		   for gitolite purposes.
		 http://gitolite.com/gitolite
		 

	config PACKAGE_subversion-client
		tristate "subversion-client................................ subversion client tools"
		default y if DEFAULT_subversion-client
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_subversion-libs
		help
		 Subversion is a free/open-source version control system. That is,
		   Subversion manages files and directories, and the changes made to them,
		   over time. This allows you to recover older versions of your data, or
		   examine the history of how your data changed. In this regard, many
		   people think of a version control system as a sort of time machine.
		   This package contains the Subversion client tools.
		 https://subversion.apache.org/
		 Val Kulkov <val.kulkov@gmail.com>

	config PACKAGE_subversion-libs
		tristate "subversion-libs.......................................... subversion libs"
		default y if DEFAULT_subversion-libs
		default m if ALL
		select PACKAGE_libiconv-full if BUILD_NLS
		select PACKAGE_libmagic
		select PACKAGE_libc
		select PACKAGE_libsqlite3
		select PACKAGE_libintl-full if BUILD_NLS
		select PACKAGE_libaprutil
		help
		 Subversion is a free/open-source version control system. That is,
		   Subversion manages files and directories, and the changes made to them,
		   over time. This allows you to recover older versions of your data, or
		   examine the history of how your data changed. In this regard, many
		   people think of a version control system as a sort of time machine.
		   This package contains the Subversion libraries.
		 https://subversion.apache.org/
		 Val Kulkov <val.kulkov@gmail.com>

	config PACKAGE_subversion-server
		tristate "subversion-server...................................... subversion server"
		default y if DEFAULT_subversion-server
		default m if ALL
		select PACKAGE_subversion-libs
		select PACKAGE_libc
		help
		 Subversion is a free/open-source version control system. That is,
		   Subversion manages files and directories, and the changes made to them,
		   over time. This allows you to recover older versions of your data, or
		   examine the history of how your data changed. In this regard, many
		   people think of a version control system as a sort of time machine.
		   This package contains the Subversion server.
		 https://subversion.apache.org/
		 Val Kulkov <val.kulkov@gmail.com>

endmenu
menu "WWAN"
	config PACKAGE_adb-enablemodem
		tristate "adb-enablemodem..................................... Enable modem via adb"
		default y if DEFAULT_adb-enablemodem
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_adb
		help
		 Enable modem via adb
		 

	config PACKAGE_comgt
		tristate "comgt............................... Option/Vodafone 3G/GPRS control tool"
		default y if DEFAULT_comgt
		default m if ALL||ALL_NONSHARED
		select PACKAGE_chat
		select PACKAGE_libc
		help
		 comgt is a scripting language interpreter useful for establishing 
		  communications on serial lines and through PCMCIA modems as well as GPRS 
		  and 3G datacards.
		 http://manpages.ubuntu.com/manpages/trusty/man1/comgt.1.html
		 Felix Fietkau <nbd@nbd.name>

	config PACKAGE_comgt-directip
		tristate "comgt-directip......................... Sierra Wireless Direct-IP support"
		default y if DEFAULT_comgt-directip
		default m if ALL||ALL_NONSHARED
		select PACKAGE_kmod-usb-net-sierrawireless
		select PACKAGE_kmod-usb-serial-sierrawireless
		select PACKAGE_kmod-usb-serial
		depends on USB_SUPPORT
		select PACKAGE_kmod-usb-net
		select PACKAGE_libc
		select PACKAGE_comgt
		help
		 Sierra Wireless Direct-IP support
		 Felix Fietkau <nbd@nbd.name>

	config PACKAGE_comgt-ncm
		tristate "comgt-ncm.............................................. NCM 3G/4G Support"
		default y if DEFAULT_comgt-ncm
		default m if ALL||ALL_NONSHARED
		select PACKAGE_kmod-usb-net-huawei-cdc-ncm
		select PACKAGE_kmod-usb-serial-option
		select PACKAGE_comgt
		select PACKAGE_libc
		select PACKAGE_wwan
		depends on USB_SUPPORT
		help
		 NCM 3G/4G Support
		 Felix Fietkau <nbd@nbd.name>

	config PACKAGE_umbim
		tristate "umbim........................ Control utility for mobile broadband modems"
		default y if DEFAULT_umbim
		default m if ALL||ALL_NONSHARED
		select PACKAGE_wwan
		select PACKAGE_libubox
		select PACKAGE_kmod-usb-net-cdc-mbim
		depends on USB_SUPPORT
		select PACKAGE_kmod-usb-net
		select PACKAGE_libc
		help
		 umbim is a command line tool for controlling mobile broadband modems using
		   the MBIM-protocol.
		 John Crispin <john@phrozen.org>

	config PACKAGE_uqmi
		tristate "uqmi......................... Control utility for mobile broadband modems"
		default y if DEFAULT_uqmi
		default m if ALL||ALL_NONSHARED
		select PACKAGE_wwan
		select PACKAGE_libubox
		select PACKAGE_libblobmsg-json
		select PACKAGE_kmod-usb-net-qmi-wwan
		select PACKAGE_kmod-usb-net
		depends on USB_SUPPORT
		select PACKAGE_libc
		help
		 uqmi is a command line tool for controlling mobile broadband modems using
		   the QMI-protocol.
		 Matti Laakso <malaakso@elisanet.fi>

endmenu
menu "Web Servers/Proxies"
