menu "Database"
	menuconfig PACKAGE_mariadb-client
		tristate "mariadb-client................................... MariaDB database client"
		default y if DEFAULT_mariadb-client
		default m if ALL
		select PACKAGE_libatomic
		select PACKAGE_libstdcpp
		select PACKAGE_libfmt
		select PACKAGE_libopenssl
		select PACKAGE_zlib
		select PACKAGE_libedit
		select PACKAGE_libc
		select PACKAGE_libiconv-full if BUILD_NLS
		help
		 MariaDB is a very fast and robust SQL database server.
		 
		 This package includes the following core client binaries:
		 
		 mysql
		 mysqlcheck
		 
		 https://mariadb.org/
		 Michal Hrusecky <Michal@Hrusecky.net>

	config PACKAGE_mariadb-client-extra
		tristate "mariadb-client-extra....................... MariaDB database client extra"
		default y if DEFAULT_mariadb-client-extra
		default m if ALL
		depends on PACKAGE_mariadb-client
		select PACKAGE_libc
		help
		 MariaDB is a very fast and robust SQL database server.
		 
		 This package includes the following extra client binaries:
		 
		 msql2mysql
		 mysql_find_rows
		 mysql_plugin
		 mysql_waitpid
		 mysqlaccess
		 mysqlbinlog
		 mysqldump
		 mysqlimport
		 mysqlshow
		 mysqlslap
		 mytop
		 
		 https://mariadb.org/
		 Michal Hrusecky <Michal@Hrusecky.net>

	config PACKAGE_mariadb-server-base
		tristate "mariadb-server-base......................... MariaDB database server base"
		default y if DEFAULT_mariadb-server-base
		default m if ALL
		select PACKAGE_libatomic
		select PACKAGE_libstdcpp
		select PACKAGE_libaio if !KERNEL_IO_URING
		select PACKAGE_libiconv-full if BUILD_NLS
		select PACKAGE_liblzma
		select PACKAGE_resolveip
		select PACKAGE_libfmt
		select PACKAGE_libopenssl
		select PACKAGE_libpcre2
		select PACKAGE_zlib
		select PACKAGE_liburing if KERNEL_IO_URING
		select PACKAGE_sudo
		select PACKAGE_libc
		help
		 MariaDB is a very fast and robust SQL database server.
		 
		 This package provides the foundation for mariadb-server. It installs the
		 init script, support files (configuration etc.), the user "mariadb" and
		 the dependencies.
		 
		 https://mariadb.org/
		 Michal Hrusecky <Michal@Hrusecky.net>

	menuconfig PACKAGE_mariadb-server
		tristate "mariadb-server................................... MariaDB database server"
		default y if DEFAULT_mariadb-server
		default m if ALL
		select PACKAGE_libc
		depends on PACKAGE_mariadb-server-base
		help
		 MariaDB is a very fast and robust SQL database server.
		 
		 This package includes the following core server binaries:
		 
		 innochecksum
		 my_print_defaults
		 mysql_install_db
		 mysql_upgrade
		 mysqladmin
		 mysqld
		 
		 https://mariadb.org/
		 Michal Hrusecky <Michal@Hrusecky.net>

