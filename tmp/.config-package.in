		depends on !(TARGET_ipq95xx) || TARGET_ipq95xx||TARGET_ipq50xx||TARGET_ipq806x||TARGET_ipq807x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64
		select PACKAGE_kmod-qca-nss-drv
		depends on !(TARGET_ipq807x) || TARGET_ipq95xx||TARGET_ipq50xx||TARGET_ipq806x||TARGET_ipq807x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64
		depends on TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx
		select PACKAGE_kmod-rmnet-core if TARGET_ipq807x
		select PACKAGE_kmod-rmnet-core if TARGET_ipq95xx
		depends on !LINUX_3_18
		depends on !(PACKAGE_kmod-qca-nss-dp) || TARGET_ipq807x
		depends on !(PACKAGE_kmod-qca-nss-dp) || (TARGET_ipq807x)
		select PACKAGE_kmod-rmnet-core if TARGET_ipq50xx
		help
		 RMNET NSS interface module
		 

