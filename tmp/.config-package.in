		depends on (aarch64||arm||i386||i686||mips||mips64||mips64el||mipsel||powerpc64||riscv64||x86_64)
		help
		 Relay server for syncthing
		 https://syncthing.net
		 Paul Spooren <mail@aparcar.org>

	config PACKAGE_stress
		tristate "stress................................. stress is a simple stress utility"
		default y if DEFAULT_stress
		default m if ALL
		select PACKAGE_libc
		help
		 stress is a simple tool that imposes certain types of compute \ stress on
		 UNIX-like operating systems.
		 Alexandru Ardelean <ardeleanalex@gmail.com>

	config PACKAGE_stress-ng
		tristate "stress-ng............................. stress-ng is a stress test utility"
		default y if DEFAULT_stress-ng
		default m if ALL
		select PACKAGE_libbsd
		select PACKAGE_libc
		select PACKAGE_libsctp
		select PACKAGE_libatomic
		select PACKAGE_libkmod
		depends on IPV6
		select PACKAGE_zlib
		select PACKAGE_libaio
		select PACKAGE_libjpeg-turbo
		help
		 stress-ng will stress test a computer system in various selectable ways. It
		 was designed to exercise various physical subsystems of a computer as well as
		 the various operating system kernel interfaces.
		 https://github.com/ColinIanKing/stress-ng
		 Alexandru Ardelean <ardeleanalex@gmail.com>

	config PACKAGE_sumo
		tristate "sumo................................. SUMO - Simulation of Urban MObility"
		default y if DEFAULT_sumo
		default m if ALL
		select PACKAGE_zlib
		select PACKAGE_libc
		select PACKAGE_libxerces-c
		help
		 SUMO is a free and open traffic simulation suite which is available since 2001.
		   SUMO allows modelling of intermodal traffic systems including road vehicles,
		   public transport and pedestrians. Included with SUMO is a wealth of supporting
		   tools which handle tasks such as route finding, visualization, network import
		   and emission calculation. SUMO can be enhanced with custom models and provides
		   various APIs to remotely control the simulation.
		 https://sumo.dlr.de/
		 Álvaro Fernández Rojas <noltari@gmail.com>

	config PACKAGE_syncthing
		tristate "syncthing........................ Continuous file synchronization program"
		default y if DEFAULT_syncthing
		default m if ALL
		depends on (aarch64||arm||i386||i686||mips||mips64||mips64el||mipsel||powerpc64||riscv64||x86_64)
		select PACKAGE_libc
		help
		 Syncthing replaces proprietary sync and cloud services with something
		   open, trustworthy and decentralized. Your data is your data alone and
		   you deserve to choose where it is stored, if it is shared with some
		   third party and how it's transmitted over the Internet.
		 https://syncthing.net
		 Paul Spooren <mail@aparcar.org>

