		depends on !(PACKAGE_kmod-qca-nss-ecm-premium && PACKAGE_kmod-qca-nss-ecm-premium-noload<PACKAGE_kmod-qca-nss-ecm-wifi-plugin && TARGET_ipq60xx) || TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx
		depends on !(PACKAGE_kmod-qca-nss-ecm-noload && PACKAGE_kmod-qca-ovsmgr) || !LINUX_3_18
		depends on !(PACKAGE_kmod-qca-nss-ecm-noload && TARGET_ipq50xx) || TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx
		depends on !(PACKAGE_kmod-qca-nss-ecm-premium && PACKAGE_kmod-qca-nss-ecm-premium-noload<PACKAGE_kmod-qca-nss-ecm-wifi-plugin && TARGET_ipq60xx && PACKAGE_kmod-qca-nss-gmac) || !LINUX_3_18
		depends on !(PACKAGE_kmod-qca-nss-ecm-noload && TARGET_ipq_ipq806x && PACKAGE_kmod-qca-nss-dp) || (TARGET_ipq807x)
		depends on !(PACKAGE_kmod-qca-nss-ecm-premium && PACKAGE_kmod-qca-nss-ecm-premium-noload<PACKAGE_kmod-qca-nss-ecm-wifi-plugin && TARGET_ipq_ipq60xx && PACKAGE_kmod-qca-nss-dp) || (TARGET_ipq807x)
		depends on !(PACKAGE_kmod-qca-nss-ecm-standard && TARGET_ipq_ipq60xx) || !LINUX_3_18
		depends on !(PACKAGE_kmod-qca-nss-ecm-noload && TARGET_ipq_ipq60xx) || !LINUX_3_18
		depends on !(PACKAGE_kmod-qca-nss-ecm-noload && TARGET_ipq53xx) || IPV6
		depends on !(PACKAGE_kmod-qca-nss-ecm-premium && PACKAGE_kmod-qca-nss-ecm-premium-noload<PACKAGE_kmod-qca-nss-ecm-wifi-plugin && TARGET_ipq_ipq50xx_64) || TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx
		depends on !(PACKAGE_kmod-qca-nss-ecm-noload && TARGET_ipq53xx && TARGET_ipq95xx) || TARGET_ipq807x
