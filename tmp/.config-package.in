	menuconfig PACKAGE_libopensc
		tristate "libopensc............................... OpenSC libraries for smart cards"
		default y if DEFAULT_libopensc
		default m if ALL
		select PACKAGE_zlib
		select PACKAGE_libpthread
		select PACKAGE_libopenssl
		select PACKAGE_libc
		help
		 OpenSC provides a set of libraries and utilities to work with smart cards.
		   Its main focus is on cards that support cryptographic operations, and
		   facilitate their use in security applications such as authentication,
		   mail encryption and digital signatures.
		 https://github.com/OpenSC/OpenSC/wiki
		 Daniel Golle <daniel@makrotopia.org>

