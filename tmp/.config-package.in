	menuconfig PACKAGE_mc
		tristate "mc................... Midnight Commander - a powerful visual file manager"
		default y if DEFAULT_mc
		default m if ALL
		select PACKAGE_libssh2 if MC_VFS
		select PACKAGE_glib2
		select PACKAGE_libncurses
		select PACKAGE_libc
		select PACKAGE_libiconv-full if BUILD_NLS
		select PACKAGE_libmount
		help
		 GNU Midnight Commander is a visual file manager.
		 It's a feature rich full-screen text mode application that allows you to copy,
		 move and delete files and whole directory trees, search for files and run commands in the subshell.
		 Internal viewer and editor are included as well.
		 
		 https://www.midnight-commander.org/
		 


	
		source "qca/feeds/packages/utils/mc/Config.in"

