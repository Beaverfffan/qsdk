		 http://selinuxproject.org/page/Main_Page
		 Thomas Petazzoni <thomas.petazzoni@bootlin.com>

	config PACKAGE_selinux-sepolicy
		tristate "selinux-sepolicy..................... SELinux management utility sepolicy"
		default y if DEFAULT_selinux-sepolicy
