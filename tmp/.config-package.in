		 This package is built with PAM support.
		 https://github.com/facebook/tac_plus/
		 

	config PACKAGE_tayga
		tristate "tayga............. Out-of-kernel stateless NAT64 implementation for Linux"
		default y if DEFAULT_tayga
		default m if ALL
		select PACKAGE_ip-tiny if PACKAGE_ip-full<PACKAGE_tayga
