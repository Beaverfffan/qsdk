		 https://github.com/wangyu-/UDPspeeder
		 Nishant Sharma <nishant@hopbox.in>, Toni Uhlig <matzeton@googlemail.com>

	config PACKAGE_aardvark-dns
		tristate "aardvark-dns.............. authoritative dns server for container records"
		default y if DEFAULT_aardvark-dns
		default m if ALL
		depends on (aarch64||arm||i386||i686||mips||mipsel||mips64||mips64el||mipsel||powerpc64||riscv64||x86_64)
		select PACKAGE_libc
		help
		 Aardvark-dns is an authoritative dns server for A/AAAA container records.
		   It can forward other requests to configured resolvers.
		 
		   It is mostly intended to be used with Netavark which will
		   launch it automatically if both are installed.
		 https://github.com/containers/aardvark-dns
		 Oskari Rauta <oskari.rauta@gmail.com>

