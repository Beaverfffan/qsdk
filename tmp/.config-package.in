		 Willem van den Akker <wvdakker@wilsoft.nl>

	menuconfig PACKAGE_snort
		tristate "snort..................... Lightweight Network Intrusion Detection System"
		default y if DEFAULT_snort
		default m if ALL
		select PACKAGE_libnghttp2
		select PACKAGE_luajit
		select PACKAGE_libpcap
		select PACKAGE_libuuid
		select PACKAGE_libdnet
		select PACKAGE_libdaq
		depends on (i386||x86_64||arm||armeb||aarch64||powerpc||mips||mipsel||mips64)
		select PACKAGE_libpthread
		select PACKAGE_libpcre
		select PACKAGE_libopenssl
		select PACKAGE_zlib
		select PACKAGE_libc
		select PACKAGE_liblzma if SNORT_LZMA
		select PACKAGE_libtirpc
		depends on m || (PACKAGE_snort3 != y)
		help
		 Snort is an open source network intrusion detection and prevention system.
		   It is capable of performing real-time traffic analysis, alerting, blocking
		   and packet logging on IP networks.  It utilizes a combination of protocol
		   analysis and pattern matching in order to detect anomalies, misuse and
		   attacks.
		 http://www.snort.org/
		 W. Michael Petullo <mike@flyn.org>


	
		source "qca/feeds/packages/net/snort/Config.in"

	menuconfig PACKAGE_snort3
		tristate "snort3.................... Lightweight Network Intrusion Detection System"
		default y if DEFAULT_snort3
		default m if ALL
		depends on (i386||x86_64||arm||armeb||aarch64||powerpc||mips||mipsel||mips64)
		depends on !((TARGET_x86||TARGET_x86_64)) || !mips
		depends on !((TARGET_x86||TARGET_x86_64)) || TARGET_x86_64
		select PACKAGE_libpcre
		select PACKAGE_ucode
		select PACKAGE_libc
		select PACKAGE_libhwloc
		select PACKAGE_libtirpc
		select PACKAGE_libdaq3
		select PACKAGE_libstdcpp
		select PACKAGE_libuuid
		select PACKAGE_gperftools-runtime if (TARGET_x86||TARGET_x86_64)
		depends on HAS_LUAJIT_ARCH
		select PACKAGE_libpthread
		select PACKAGE_libopenssl
		select PACKAGE_ucode-mod-uci
		select PACKAGE_ucode-mod-fs
		select PACKAGE_zlib
		select PACKAGE_hyperscan-runtime if (TARGET_x86||TARGET_x86_64)
		depends on !((TARGET_x86||TARGET_x86_64)) || !powerpc
		depends on !((TARGET_x86||TARGET_x86_64)) || ((mips||mipsel||mips64||powerpc64||x86_64||arm||aarch64)||(USE_GLIBC&&(powerpc||i386)))
		select PACKAGE_luajit
		select PACKAGE_libpcap
		select PACKAGE_libatomic
		depends on !((TARGET_x86||TARGET_x86_64)) || !mipsel
		select PACKAGE_kmod-nft-queue
		select PACKAGE_liblzma
		select PACKAGE_libdnet
		help
		 Snort is an open source network intrusion detection and prevention system.
		   It is capable of performing real-time traffic analysis, alerting, blocking
		   and packet logging on IP networks.  It utilizes a combination of protocol
		   analysis and pattern matching in order to detect anomalies, misuse and
		   attacks.
		 http://www.snort.org/
		 W. Michael Petullo <mike@flyn.org>

