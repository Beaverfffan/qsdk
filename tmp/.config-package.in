		select PACKAGE_kmod-tun
		help
		 Open source VPN solution using WolfSSL \(experimental\)
		 http://openvpn.net
		 Magnus Kroken <mkroken@gmail.com>


	
		source "qca/feeds/packages/net/openvpn/Config-wolfssl.in"

	config PACKAGE_pptpd
