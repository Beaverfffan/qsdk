	config PACKAGE_libnl-nss
		tristate "libnl-nss"
		default y if DEFAULT_libnl-nss
		default m if ALL
		depends on !LINUX_3_18
		depends on !(PACKAGE_kmod-qca-nss-drv-ipsecmgr) || TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx||TARGET_ipq807x||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq95xx||TARGET_ipq95xx_32
		depends on !(PACKAGE_kmod-qca-nss-drv-capwapmgr) || TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx||TARGET_ipq807x||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq95xx||TARGET_ipq95xx_32
		depends on TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx
		depends on !TARGET_ipq95xx
		depends on !(PACKAGE_kmod-qca-nss-drv-dtlsmgr) || TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq95xx||TARGET_ipq95xx_32
		select PACKAGE_libpthread
		depends on !(PACKAGE_kmod-qca-nss-dp) || (TARGET_ipq807x)
		depends on !(PACKAGE_kmod-qca-nss-drv-dtlsmgr && TARGET_ipq95xx) || PACKAGE_kmod-qca-nss-drv-lite
		depends on !(PACKAGE_kmod-qca-nss-drv-ipsecmgr && TARGET_ipq95xx) || PACKAGE_kmod-qca-nss-drv-lite
		depends on !(PACKAGE_kmod-qca-nss-drv-capwapmgr) || TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq95xx||TARGET_ipq95xx_32
		depends on !(PACKAGE_kmod-qca-nss-drv-ipsecmgr && !LINUX_5_4 && TARGET_ipq95xx) || PACKAGE_kmod-qca-nss-drv-lite
		depends on !(PACKAGE_kmod-qca-nss-drv-dtlsmgr) || TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx||TARGET_ipq807x||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq95xx||TARGET_ipq95xx_32
		depends on !(PACKAGE_kmod-qca-nss-gmac) || TARGET_ipq806x||TARGET_ipq_ipq806x
		select PACKAGE_kmod-qca-nss-drv-netlink
		select PACKAGE_libnl
		depends on !(PACKAGE_kmod-qca-nss-drv-ipsecmgr && !LINUX_5_4) || TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq95xx||TARGET_ipq95xx_32
		depends on !(PACKAGE_kmod-qca-nss-drv-capwapmgr && TARGET_ipq95xx) || PACKAGE_kmod-qca-nss-drv-lite
		depends on !(PACKAGE_kmod-qca-nss-dp) || TARGET_ipq807x
		depends on !(PACKAGE_kmod-qca-nss-drv-ipsecmgr) || TARGET_ipq806x||TARGET_ipq_ipq806x||TARGET_ipq_ipq807x||TARGET_ipq_ipq807x_64||TARGET_ipq807x||TARGET_ipq_ipq50xx||TARGET_ipq_ipq50xx_64||TARGET_ipq50xx||TARGET_ipq_ipq60xx||TARGET_ipq_ipq60xx_64||TARGET_ipq60xx||TARGET_ipq95xx||TARGET_ipq95xx_32
		depends on !(PACKAGE_kmod-qca-nss-drv-ipsecmgr && PACKAGE_kmod-qca-nss-drv-l2tpv2 && IPV6) || IPV6
		select PACKAGE_libc
		help
		 A framework in the userspace that establishes communication between userspace applications and the kernel.
		 

	config PACKAGE_libnl-ppe
		tristate "libnl-ppe"
		default y if DEFAULT_libnl-ppe
		default m if ALL
		select PACKAGE_kmod-qca-nss-ppe-netlink
		select PACKAGE_libc
		depends on (TARGET_ipq807x)
		depends on TARGET_ipq807x
		select PACKAGE_libnl
		depends on IPV6
		depends on TARGET_ipq95xx||TARGET_ipq53xx
		depends on !LINUX_3_18
		select PACKAGE_libpthread
		help
		 Library to facilitate communication from user to kernel for the PPE netlink families.
		 

	config PACKAGE_libnl-route
		tristate "libnl-route...................................... Routing Netlink Library"
		default y if DEFAULT_libnl-route
		default m if ALL
		select PACKAGE_libnl-core
		select PACKAGE_libc
		help
		 Routing Netlink Library Functions
		 http://www.infradead.org/~tgr/libnl/
		 

	config PACKAGE_libnl-tiny
		tristate "libnl-tiny........................................ netlink socket library"
		default y if DEFAULT_libnl-tiny
		default m if ALL
