		depends on PACKAGE_kmod-w1
		select PACKAGE_kmod-i2c-core
		help
		 Kernel module for the DS2482 i2c 1-wire bus master driver
		  NOTE: Init with: echo ds2482 0x18 > /sys/bus/i2c/devices/i2c-0/new_device
		  or use owfs
		 

