		help
		 Port of the Fraunhofer FDK AAC Codec Library for Android
		 https://sourceforge.net/projects/opencore-amr/
		 Ted Hess <thess@kitschensync.net>


	
	  source "qca/feeds/packages/sound/fdk-aac/Config.in"

	config PACKAGE_ices
		tristate "ices..................... ices client for Icecast media streaming servers"
		default y if DEFAULT_ices
