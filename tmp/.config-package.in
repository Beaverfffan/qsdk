		 https://github.com/zhaojh329/lua-eco
		 Jianhui Zhao <zhaojh329@gmail.com>


	
		choice
			prompt "SSL Library"
			default LUA_ECO_MBEDTLS
	
			config LUA_ECO_OPENSSL
				bool "OpenSSL"
	
			config LUA_ECO_WOLFSSL
				bool "wolfSSL"
	
