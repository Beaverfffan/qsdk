		default y if DEFAULT_nginx-mod-dav-ext
		default m if ALL
		select PACKAGE_libxml2
		select PACKAGE_libc
		select NGINX_DAV
		select PACKAGE_nginx-ssl if PACKAGE_nginx-full<PACKAGE_nginx-mod-dav-ext
		help
		 Enable the WebDAV methods PROPFIND OPTIONS LOCK UNLOCK.
		 http://nginx.org/
		 Thomas Heil <heil@terminal-consulting.de> Ansuel Smith <ansuelsmth@gmail.com>

	config PACKAGE_nginx-mod-headers-more
		tristate "nginx-mod-headers-more......................... Nginx headers-more module"
		default y if DEFAULT_nginx-mod-headers-more
		default m if ALL
		select PACKAGE_nginx-ssl if PACKAGE_nginx-full<PACKAGE_nginx-mod-headers-more
		select PACKAGE_libc
		help
		 Set and clear input and output headers...more than "add"!
		 http://nginx.org/
		 Thomas Heil <heil@terminal-consulting.de> Ansuel Smith <ansuelsmth@gmail.com>

	config PACKAGE_nginx-mod-lua
		tristate "nginx-mod-lua........................................... Nginx lua module"
		default y if DEFAULT_nginx-mod-lua
		default m if ALL
		select PACKAGE_nginx-ssl if PACKAGE_nginx-full<PACKAGE_nginx-mod-lua
		depends on (i386||x86_64||arm||armeb||aarch64||powerpc||mips||mipsel||mips64)
		select PACKAGE_libc
		select PACKAGE_luajit
		help
		 Enable Lua module
		 http://nginx.org/
		 Thomas Heil <heil@terminal-consulting.de> Ansuel Smith <ansuelsmth@gmail.com>

	config PACKAGE_nginx-mod-luci
		tristate "nginx-mod-luci.................................... Support file for Nginx"
		default y if DEFAULT_nginx-mod-luci
		default m if ALL
		select PACKAGE_nginx-mod-ubus
		select PACKAGE_uwsgi-luci-support
		select PACKAGE_uwsgi
		select PACKAGE_libc
		select PACKAGE_nginx
		help
		 Support file for LuCI in nginx. Include custom nginx configuration, autostart script for uwsgi.
		 http://nginx.org/
		 Thomas Heil <heil@terminal-consulting.de> Ansuel Smith <ansuelsmth@gmail.com>

	config PACKAGE_nginx-mod-naxsi
